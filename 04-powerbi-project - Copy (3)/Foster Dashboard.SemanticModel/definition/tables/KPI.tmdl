	measure 'Prior Year Same Month Variance %' =
			
			DIVIDE(
			    [Latest Month Fostered Animals]
			        - [Prior Year Same Month Fostered Animals],
			    [Prior Year Same Month Fostered Animals]
			)
		displayFolder: Capacity & Support\Last Month Comparison
