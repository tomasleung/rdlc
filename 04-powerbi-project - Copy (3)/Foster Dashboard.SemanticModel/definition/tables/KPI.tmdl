	measure '5-Year Monthly Benchmark' =
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR BenchmarkMonth =
			    MONTH(LatestDate)
			
			VAR BenchmarkYear =
			    YEAR(LatestDate)
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        BenchmarkYear - 5,
			        BenchmarkYear - 1,
			        1
			    ),
			    VAR PriorYear = [Value]
			    RETURN
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = PriorYear,
			            'Date'[Month] = BenchmarkMonth
			        )
			)
		formatString: #,0
