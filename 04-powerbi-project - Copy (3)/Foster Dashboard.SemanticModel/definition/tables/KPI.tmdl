	measure 'Prior Year Same Month Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR PriorYear =
			    YEAR(LatestDate) - 1
			
			VAR CurrentMonth =
			    MONTH(LatestDate)
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = PriorYear,
			    'Date'[Month] = CurrentMonth
			)
