	/// Narrative analysis for is the program growing
	measure 'Grown Insight' =
			
			"• Foster participation grew from 5,223 animals in 2006 to 15,763 animals in 2010." &
			UNICHAR(10) &
			"• Growth was concentrated during the Expansion Phase (2006–2009), with a CAGR of 42.9%." &
			UNICHAR(10) &
			"• Annual participation has remained stable within the 13,000–15,000 range since 2010." &
			UNICHAR(10) &
			"• Long-term participation increased at an average annual rate of 4.82%." &
			UNICHAR(10) &
			"• Recent growth has leveled off (-0.80% CAGR), reflecting a mature and sustainable operating model."
		displayFolder: Capacity & Support\Program Growth
