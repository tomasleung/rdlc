	measure 'Seasonality Heatmap Color' =
			
			VAR Value_ = [Fostered Animals]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Value_), BLANK(),
			
			    Value_ < 3000,  "#D1D5DB",   -- Gray
			    Value_ < 4000,  "#EEE4C8",   -- Beige
			    Value_ < 6000,  "#E9D78C",   -- Light Gold
			    Value_ < 8000,  "#E7B95B",   -- Gold
			
			    Value_ < 9000,  "#E89A2A",   -- Light Orange
			    Value_ < 9500,  "#D97706",   -- Orange
			
			    Value_ < 10000, "#B85C00",   -- Dark Orange
			    Value_ < 10500, "#8B3E00",   -- Brown
			
			    "#6B250A"                    -- Darkest Peak
			)
			// VAR ValueTemp =
			//     [Monthly Foster Participation]
			
			// RETURN
			// SWITCH(
			//     TRUE(),
			
			//     ValueTemp >= 9500, "#92400E",   // Dark Brown
			
			//     ValueTemp >= 8500, "#D97706",   // Orange
			
			//     ValueTemp >= 7000, "#F59E0B",   // Amber
			
			//     ValueTemp >= 5000, "#FCD34D",   // Yellow
			
			//     ValueTemp >= 2500, "#FEF3C7",   // Light Yellow
			
			//     ValueTemp >= 1000, "#E2E8F0",   // Gray
			
			//     "#F8FAFC"                       // Light Gray
			// )
		displayFolder: Seasonal Operations
		lineageTag: 949788ff-4604-4f5f-9efc-81b7377850d9

	/// Executive-level summary of seasonal participation patterns, peak activity periods, benchmark performance, and operational planning priorities.
	/// 
	/// Provides the primary executive briefing narrative for the Capacity Planning & Seasonal Operations section.
	measure 'Seasonality Executive Conclusion' =
			
			"• 2026 foster participation has remained closely aligned with the five-year seasonal benchmark." &
			UNICHAR(10) &
			"• Peak foster activity consistently occurs between June and October." &
			UNICHAR(10) &
			"• June is the highest average participation month, while February remains the lowest." &
			UNICHAR(10) &
			"• August 2026 participation reached 9,358 animals, only 0.8% below the historical benchmark." &
			UNICHAR(10) &
			"• Current trends indicate no material deviation from expected seasonal demand levels."
		displayFolder: Seasonal Operations
		lineageTag: d2558536-f212-4582-b90d-bdc06aaa035f

	/// Executive summary explaining the dashboard methodology, benchmark framework, forecasting approach, and forecast validation results.
	/// 
	/// Used within the Methodology, Benchmark, and Trust Center page to provide transparency into how Foster Program metrics are calculated and interpreted.
	/// 
	/// This measure combines static methodology explanations with dynamic forecast accuracy metrics to ensure the Trust Center remains current as new forecasting validation results become available.
	measure 'Trust Center Narrative' =
			
			"The dashboard uses Foster Animal Count as its primary reporting metric because it represents the number of unique animals receiving foster care during a reporting period."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "Monthly benchmarks are based on recent historical participation patterns using a five-year seasonal benchmark methodology. These benchmarks are used to evaluate current performance, identify seasonal demand patterns, and support operational planning activities."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "Year-end projections use Historical Ratio Forecasting based on historical August completion rates. This methodology estimates full-year foster participation by comparing year-to-date activity against historical completion patterns."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "Historical validation produced an average forecast error of approximately ±"
			& FORMAT([Average Forecast Error %], "0.0%")
			& ", demonstrating that the forecasting methodology performs well when tested against completed reporting years."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "Together, these methods provide a consistent, transparent, and evidence-based foundation for monitoring performance, evaluating program trends, and planning future foster program operations."
		displayFolder: Executive Briefing
		lineageTag: 7ff312c7-fbff-4f97-a3b0-bf9533b43a76

	/// Dynamic report title displaying the Foster Program Historical & Forecast Baseline report name and the available data period. Automatically updates based on the earliest and latest dates in the model, ensuring the report header always reflects the current reporting range without manual maintenance.
	measure 'Report Title' =
			
			VAR FirstDateKey =
			    CALCULATE(
			        MIN('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR LastDateKey =
			    CALCULATE(
			        MAX('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR StartDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], FirstDateKey
			    )
			
			VAR EndDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], LastDateKey
			    )
			
			RETURN
			    "Foster Program Historical & Forecast Baseline ( " &
			    FORMAT(StartDate,"yyyy MMM") &
			    " - " &
			    FORMAT(EndDate,"yyyy MMM") &
			    " )"
		displayFolder: Capacity & Support\Titles
		lineageTag: 31803443-7e8c-4081-ba19-136bf8f5340f

	/// Compound Annual Growth Rate (CAGR) during the Expansion Phase (2006-2009).
	/// 
	/// Measures the annualized growth rate of Fostered Animals participation from the program's first reporting year through the end of the initial expansion period.
	/// 
	/// Used to quantify the speed of program growth during the Foster Program's early development stage and to compare growth dynamics across lifecycle eras.
	/// 
	/// Formula:
	/// 
	/// (Ending Value ÷ Starting Value) ^ (1 ÷ Number of Years) - 1
	/// 
	/// Period:
	/// 
	/// 2006-2009
	/// 
	/// Business Meaning:
	/// 
	/// Represents the average annual growth rate required for Fostered Animals participation to increase from the 2006 baseline to the 2009 participation level.
	/// `
	measure 'Expansion Phase CAGR' =
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = 2006
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = 2009
			    )
			
			RETURN
			POWER(
			    DIVIDE(EndValue, StartValue),
			    1 / 3
			) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 9b489d61-9d77-4dd5-b6f0-6fdd2d187a0d

	/// Compound Annual Growth Rate (CAGR) during the Peak Activity Phase (2010-2014).
	/// 
	/// Used to measure the annualized participation growth rate during the program's highest-volume operating period.
	measure 'Peak Activity CAGR' =
			
			VAR StartYear =
			    2010
			
			VAR EndYear =
			    2014
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 46f96181-9abb-4462-9b19-98192c588b23

	/// Compound Annual Growth Rate (CAGR) during the Stable Operations Phase (2015-2019).
	/// 
	/// Used to evaluate participation changes during the program's long-term stable operating period.
	measure 'Stable Operations CAGR' =
			
			VAR StartYear =
			    2015
			
			VAR EndYear =
			    2019
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 6325261e-d834-4a8c-8068-f9ffda11a169

	/// Compound Annual Growth Rate (CAGR) during the Mature Program Phase (2020 through the latest completed reporting year).
	/// 
	/// Used to evaluate recent participation trends within the program's current operating era.
	measure 'Mature Program CAGR' =
			
			VAR StartYear =
			    2020
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 8ed1f172-8e3a-4a28-bebb-0fbcdc8a4d89

	measure 'Expansion Phase CAGR Label' =
			
			"Expansion Phase"
			
			& " (2006-09)"
			& UNICHAR(10)
			& "CAGR "
			& FORMAT([Expansion Phase CAGR], "+0.0%;-0.0%")
		displayFolder: Capacity & Support\Program Growth
		lineageTag: f183b1e3-2d3b-4b4b-932e-010d3230dbfc

	measure 'Peak Activity CAGR Label' =
			
			"Peak Activity"
			
			& " (2010-14)"
			& UNICHAR(10)
			& "CAGR "
			& FORMAT([Peak Activity CAGR], "+0.0%;-0.0%")
		displayFolder: Capacity & Support\Program Growth
