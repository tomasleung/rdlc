	/// Executive summary headline describing the projected year-end Fostered Animals outcome relative to historical performance.
	/// 
	/// Used as the primary conclusion for the Forecast Outlook section.
	measure 'Forecast Outlook Headline' = ```
			
			FORMAT(
			    [Latest Reporting Year],
			    "0"
			)
			& " is projected at approximately "
			& FORMAT(
			    [Year-End Projection],
			    "#,0"
			)
			& " fostered animals, in line with historical expectations."
			
