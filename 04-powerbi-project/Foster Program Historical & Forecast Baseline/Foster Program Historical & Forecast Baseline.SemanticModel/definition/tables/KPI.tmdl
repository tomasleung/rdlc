	measure '5-Year Monthly Benchmark' =
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR BenchmarkMonth =
			    MONTH(LatestDate)
			
			VAR BenchmarkYear =
			    YEAR(LatestDate)
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        BenchmarkYear - 5,
			        BenchmarkYear - 1,
			        1
			    ),
			    VAR PriorYear = [Value]
			    RETURN
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = PriorYear,
			            'Date'[Month] = BenchmarkMonth
			        )
			)
		formatString: #,0
		displayFolder: Capacity & Support\Last Month Comparison
		lineageTag: dfbf65c5-3b12-4ba1-8e54-7228650e80c6

	measure 'Latest Month Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Foster Animal Month'[Month Date Key] = LatestMonthKey
