	/// Narrative interpretation of the Rapid Growth phase (2006-2009), summarizing participation and utilization trends. Used as the "What happened" text on the Rapid Growth phase-story card.
	measure 'Rapid Growth Phase Insight' = "Foster participation and utilization increased rapidly during the program's early growth years."
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: 5bf15151-515e-4035-9433-9baac982ea87

	/// Narrative interpretation of the Program Transition phase (2010-2013), summarizing participation and utilization trends. Used as the "What happened" text on the Program Transition phase-story card.
	measure 'Program Transition Phase Insight' = "Foster participation declined from peak levels, while utilization continued increasing."
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: ac3a4317-5060-4230-b262-636410fda899

	/// Narrative interpretation of the Stable Operations phase (2014-2019), summarizing participation and utilization trends. Used as the "What happened" text on the Stable Operations phase-story card.
	measure 'Stable Operations Phase Insight' = "Foster participation and utilization stabilized within a consistent operating range."
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: c0452797-f7eb-414f-8b40-38f5c423a17d

	/// Narrative interpretation of the High Utilization phase (2020 through the latest completed reporting year), summarizing participation and utilization trends. Used as the "What happened" text on the High Utilization phase-story card.
	measure 'High Utilization Phase Insight' = "Foster utilization reached the highest levels observed historically despite lower participation volumes."
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: 8406a719-04ee-4d53-8fea-9ce7feb58f13

	/// difference between the peak seasonal month and the lowest seasonal month based on the 5-Year Seasonal Benchmark curve.
	/// 
	measure 'Seasonal Range Animals' = ```
			
			
			    [Peak Month Fostered Animals]
			        - [Lowest Month Fostered Animals]
			```
		formatString: #,0
		displayFolder: Q3 — Seasonality
		lineageTag: 78cbfe22-339b-4600-abbd-4aed06c029c1

	/// Foster utilization rate across the most recent five completed reporting years: total Fostered Animals divided by total Intake Animal summed over that period (not a simple average of yearly percentages). Used on the Q2 Recent Stability card.
	measure 'Recent Average Utilization %' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR FosterAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= StartYear &&
			            'Date'[Year] <= EndYear
			        ),
			        CALCULATE([Fostered Animals])
			    )
			
			VAR IntakeAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= StartYear &&
			            'Date'[Year] <= EndYear
			        ),
			        CALCULATE([Intake Animal])
			    )
			
			RETURN
			DIVIDE(
			    FosterAnimals,
			    IntakeAnimals
			)
		formatString: 0%;-0%;0%
		displayFolder: Q2 — Recent Stability
		lineageTag: 801ed5c8-71df-4d74-91ea-cca4127f418a

	/// Returns the latest reporting month (derived from the Foster Animal Month snapshot table, not the Date table) formatted as "yyyy MMM", e.g. "2026 Sep". Used as a compact text label wherever the full latest reporting date is too long or a formatted date value is needed instead of a raw date field.
	measure 'Latest Reporting Month Label' = ```
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], LatestMonthKey
			    )
			RETURN
			    FORMAT(LatestDate, "yyyy MMM")
			
			```
		displayFolder: KPI Scorecards
		lineageTag: 44a188ef-eef7-4d01-8d48-e7e459351cef

	partition KPI = m
		mode: import
		source =
				let
				    Source = Table.FromRows(
				        Json.Document(
				            Binary.Decompress(
				                Binary.FromText("i44FAA==", BinaryEncoding.Base64),
				                Compression.Deflate
				            )
				        ),
				        let _t = ((type nullable text) meta [Serialized.Text = true])
				        in type table [Column1 = _t]
				    ),
				    #"Removed Columns" =
				        Table.RemoveColumns(Source, {"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

