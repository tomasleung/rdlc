	measure '5-Year Benchmark Monthly Label' =
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR BenchmarkYear =
			    YEAR(LatestDate)
			
			VAR StartYear =
			    BenchmarkYear - 5
			
			VAR EndYear =
			    BenchmarkYear - 1
			
			RETURN
			FORMAT(StartYear,"0")
			    & "-"
