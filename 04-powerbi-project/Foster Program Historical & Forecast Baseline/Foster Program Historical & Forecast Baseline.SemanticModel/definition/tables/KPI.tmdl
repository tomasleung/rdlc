	/// Average Fostered Animals for the same calendar month across the five years immediately prior to the latest reporting month. Anchored to the latest reporting date's month, not a fixed calendar month. Used as the comparison benchmark for the current month's performance.
	measure '5-Year Monthly Benchmark' =
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR BenchmarkMonth =
			    MONTH(LatestDate)
			
			VAR BenchmarkYear =
			    YEAR(LatestDate)
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        BenchmarkYear - 5,
			        BenchmarkYear - 1,
			        1
			    ),
			    VAR PriorYear = [Value]
			    RETURN
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = PriorYear,
			            'Date'[Month] = BenchmarkMonth
			        )
			)
		formatString: #,0
		displayFolder: KPI Scorecards
		lineageTag: dfbf65c5-3b12-4ba1-8e54-7228650e80c6

	/// Fostered Animals count for the most recent month present in the Foster Animal Month snapshot table. Used as the 'current month' figure in last-month comparison cards and status badges.
	measure 'Latest Month Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Foster Animal Month'[Month Date Key] = LatestMonthKey
			)
		formatString: #,0
		displayFolder: KPI Scorecards
		lineageTag: a7b177c9-d173-4cf9-8dc4-277a89c5390f

	/// Percentage difference between Latest Month Fostered Animals and the 5-Year Monthly Benchmark. Formula: (Latest Month - 5-Year Monthly Benchmark) / 5-Year Monthly Benchmark.
	measure 'Monthly Benchmark Variance %' = ```
			
			DIVIDE(
			    [Latest Month Fostered Animals]
			        - [5-Year Monthly Benchmark],
			    [5-Year Monthly Benchmark]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Scorecards
		lineageTag: 6ab27e7e-8caa-4b0a-ab45-8774739d0c98

	/// Performance classification based on the absolute value of Monthly Benchmark Variance %. Thresholds: On Target within ±10%, Monitor between 10% and 15%, Action Required beyond 15%.
	measure 'Monthly Performance Status' =
			
			VAR VariancePct =
			    ABS([Monthly Benchmark Variance %])
			RETURN
			    SWITCH(
			        TRUE(),
			        VariancePct <= 0.10, "🟢 On Target",
			        VariancePct <= 0.15, "🟡 Monitor",
			        "🔴 Action Required"
			    )
		displayFolder: KPI Scorecards\_Formatting & Display
		lineageTag: 83bb439d-3cb4-4b57-87d4-54e92f3f0e99

	/// Fostered Animals count for the same calendar month as the latest reporting month, one year earlier. Used as the year-over-year comparison baseline for the current month.
	measure 'Prior Year Same Month Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR PriorYear =
			    YEAR(LatestDate) - 1
			
			VAR CurrentMonth =
			    MONTH(LatestDate)
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = PriorYear,
			    'Date'[Month] = CurrentMonth
			)
		formatString: 0
		displayFolder: KPI Scorecards
		lineageTag: dec553fb-3d2b-4327-b4aa-b46cb176413b

	/// Percentage difference between Latest Month Fostered Animals and Prior Year Same Month Fostered Animals. Formula: (Latest Month - Prior Year Same Month) / Prior Year Same Month.
	measure 'Prior Year Same Month Variance %' =
			
			DIVIDE(
			    [Latest Month Fostered Animals]
			        - [Prior Year Same Month Fostered Animals],
			    [Prior Year Same Month Fostered Animals]
			)
		displayFolder: KPI Scorecards
		lineageTag: 5a7b553f-9761-4d6b-b228-2df27e63ed70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Formatted year-over-year label showing Prior Year Same Month Variance % with a directional arrow, the month name, and the prior year. Example: ▲ 3.2% vs August 2025.
	measure 'Prior Year Same Month Comparison Label' =
			
			VAR VariancePct =
			    [Prior Year Same Month Variance %]
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			RETURN
			IF(
			    VariancePct >= 0,
			    "▲ ",
			    "▼ "
			)
			& FORMAT(ABS(VariancePct), "0.00%")
			& " vs "
			& FORMAT(LatestDate, "MMMM")
			& " "
			& FORMAT(YEAR(LatestDate) - 1, "0")
		displayFolder: KPI Scorecards\_Formatting & Display
		lineageTag: 2a84825e-269e-4c5c-b900-28ec65ec5d84

	/// Distinct animals that participated in foster care from January 1 through the same reporting month in the prior year.
	/// 
	/// The reporting cutoff month is determined by the latest Month Date Key available in the Foster Animal Month snapshot table.
	measure 'Prior Year YTD Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR PriorYearDate =
			    DATE(
			        YEAR(LatestDate) - 1,
			        MONTH(LatestDate),
			        DAY(LatestDate)
			    )
			
			VAR PriorYear =
			    YEAR(PriorYearDate)
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = PriorYear,
			    'Date'[Date] <= PriorYearDate
			)
		formatString: #,0
		displayFolder: KPI Scorecards
		lineageTag: 3a81ad2b-2c38-450c-9ade-aea8cec4ffea

	/// Current year Fostered Animals from January through latest reporting month.
	/// 
	measure 'YTD Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR LatestYear =
			    YEAR(LatestDate)
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = LatestYear,
			    'Date'[Date] <= LatestDate
			)
		formatString: #,0
		displayFolder: KPI Scorecards
		lineageTag: 43adac16-cb30-4c38-9125-02189dadfcae

	/// Percentage difference between the current YTD Fostered Animals count and the equivalent YTD period in the prior year.
	/// 
	/// Formula:
	/// (Current YTD - Prior Year YTD) / Prior Year YTD
	measure 'Prior Year YTD Variance %' =
			
			DIVIDE(
			    [YTD Fostered Animals]
			        - [Prior Year YTD Fostered Animals],
			    [Prior Year YTD Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Scorecards
		lineageTag: 559bb72e-15e4-4c2d-a1a3-689e038f73dc

	/// Formatted year-over-year YTD comparison label showing the percentage change from the prior year YTD period.
	/// 
	/// Examples:
	/// ▲ 3.2% vs Aug 2025 YTD
	/// ▼ 0.5% vs Aug 2025 YTD
	measure 'Prior Year YTD Comparison Label' =
			
			VAR VariancePct =
			    [Prior Year YTD Variance %]
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR PriorYear =
			    YEAR(LatestDate) - 1
			
			VAR MonthName =
			    FORMAT(LatestDate, "MMM")
			
			VAR DirectionIcon =
			    IF(
			        VariancePct >= 0,
			        "▲ ",
			        "▼ "
			    )
			
			RETURN
			DirectionIcon
			    & FORMAT(ABS(VariancePct), "0.00%")
			    & " vs "
			    & MonthName
			    & " "
			    & PriorYear
			    & " YTD"
		displayFolder: KPI Scorecards\_Formatting & Display
		lineageTag: 48b73c01-41a0-4d96-985f-303bdeb0f8e3

	/// Average YTD Fostered Animals through the latest reporting month across the previous five completed years.
	/// 
	/// Example:
	/// 
	/// Latest Reporting Month = Aug 2026
	/// 
	/// Calculate:
	/// Jan-Aug 2021 Fostered Animals
	/// Jan-Aug 2022 Fostered Animals
	/// Jan-Aug 2023 Fostered Animals
	/// Jan-Aug 2024 Fostered Animals
	/// Jan-Aug 2025 Fostered Animals
	/// 
	/// Average the five YTD values.
	measure '5-Year YTD Benchmark' =
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			VAR ReportingMonth =
			    MONTH(LatestDate)
			
			VAR ReportingYear =
			    YEAR(LatestDate)
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        ReportingYear - 5,
			        ReportingYear - 1,
			        1
			    ),
			    VAR BenchmarkYear = [Value]
			    RETURN
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = BenchmarkYear,
			            'Date'[Month] <= ReportingMonth
			        )
			)
		formatString: #,0
		displayFolder: KPI Scorecards
		lineageTag: 2df81bd2-86d0-4b5e-b35c-0050a73051a8

	/// Percentage difference between current YTD Fostered Animals and the 5-Year YTD Benchmark.
	/// 
	/// Formula:
	/// 
	/// (Current YTD Fostered Animals - 5-Year YTD Benchmark)
	/// /
	/// 5-Year YTD Benchmark
	/// 
	measure 'YTD Benchmark Variance %' =
			
			DIVIDE(
			    [YTD Fostered Animals]
			        - [5-Year YTD Benchmark],
			    [5-Year YTD Benchmark]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Scorecards
		lineageTag: 9ae88b88-f31a-4fef-a4ce-8e105d22f42c

	/// Performance classification based on YTD Benchmark Variance %.
	/// 
	/// Thresholds:
	/// 
	/// 🟢 On Target
	/// Within ±10% of benchmark
	/// 
	/// 🟡 Monitor
	/// Between 10% and 15% variance
	/// 
	/// 🔴 Action Required
	/// Greater than 15% variance
	/// 
	measure 'YTD Performance Status' =
			
			VAR VariancePct =
			    ABS([YTD Benchmark Variance %])
			RETURN
			    SWITCH(
			        TRUE(),
			        VariancePct <= 0.10, "🟢 On Target",
			        VariancePct <= 0.15, "🟡 Monitor",
			        "🔴 Action Required"
			    )
		displayFolder: KPI Scorecards\_Formatting & Display
		lineageTag: 2368ba1d-0c28-4688-a204-8808622fc454

	/// Average percentage of annual Fostered Animals that had occurred by the latest reporting month across the previous five completed years.
	/// 
	/// Example:
	/// 
	/// Latest Reporting Month = August 2026
	/// 
	/// For each year:
	/// 
	/// 2021 Jan-Aug Fostered Animals ÷ 2021 Full Year Fostered Animals
	/// 2022 Jan-Aug Fostered Animals ÷ 2022 Full Year Fostered Animals
	/// 2023 Jan-Aug Fostered Animals ÷ 2023 Full Year Fostered Animals
	/// 2024 Jan-Aug Fostered Animals ÷ 2024 Full Year Fostered Animals
	/// 2025 Jan-Aug Fostered Animals ÷ 2025 Full Year Fostered Animals
	/// 
	/// Average the five completion ratios.
	/// 
	/// Expected Result:
	/// 88.5%
	measure 'Historical Completion Ratio' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR ReportingMonth =
			    MONTH(LatestDate)
			
			VAR ReportingYear =
			    YEAR(LatestDate)
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        ReportingYear - 5,
			        ReportingYear - 1
			    ),
			    VAR BenchmarkYear = [Value]
			
			    VAR YTDValue =
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = BenchmarkYear,
			            'Date'[Month] <= ReportingMonth
			        )
			
			    VAR FullYearValue =
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = BenchmarkYear
			        )
			
			    RETURN
			        DIVIDE(
			            YTDValue,
			            FullYearValue
			        )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 95aaee2d-ccac-404a-96fd-032ef54b6a20

	/// Projects the total Fostered Animals count for the current reporting year using the historical YTD completion ratio.
	/// 
	/// Formula:
	/// 
	/// Current YTD Fostered Animals
	/// /
	/// Historical Completion Ratio
	/// 
	/// Example:
	/// 
	/// Current YTD = 11,312
	/// Historical Completion Ratio = 88.4%
	/// 
	/// 11,312 / 0.884 = 12,800
	measure 'Year-End Projection' =
			
			ROUND(
			    DIVIDE(
			        [YTD Fostered Animals],
			        [Historical Completion Ratio]
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Q4 — Forecast Outlook
		lineageTag: b2ef1056-2c13-4e07-9d81-7a4c5b86a919

	/// Percentage difference between the projected year-end Fostered Animals count and the most recent completed year's actual Fostered Animals count.
	/// 
	/// Formula:
	/// 
	/// (Year-End Projection - Prior Year Actual Fostered Animals)
	/// /
	/// Prior Year Actual Fostered Animals
	measure 'Forecast Variance %' =
			
			DIVIDE(
			    [Year-End Projection]
			        - [Latest Completed Year Fostered Animals],
			    [Latest Completed Year Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 08e34091-0ffe-4817-8c19-aaca0dcfa340

	/// Executive interpretation of the projected year-end Fostered Animals count compared to the most recent completed year's actual Fostered Animals count.
	/// 
	/// Thresholds:
	/// 
	/// 🟢 Projected to Finish Near Prior Year Levels
	/// Within ±10%
	/// 
	/// 🟡 Projected to Finish Moderately Above/Below Prior Year
	/// Between 10% and 15%
	/// 
	/// 🔴 Projected to Finish Significantly Above/Below Prior Year
	/// Greater than 15%
	measure 'Forecast Status' =
			
			VAR VariancePct =
			    ABS([Forecast Variance %])
			RETURN
			    SWITCH(
			        TRUE(),
			        VariancePct <= 0.10,
			            "🟢 On Target",
			
			        VariancePct <= 0.15,
			            "🟡 Projected to Finish Moderately Above/Below Prior Year",
			
			        "🔴 Projected to Finish Significantly Above/Below Prior Year"
			    )
		displayFolder: Q4 — Forecast Outlook\_Formatting & Display
		lineageTag: 1fbc063d-128f-4a8d-abbc-b37d2b53ddc0

	/// Displays the full historical reporting range as '<First Reporting Year>-<Latest Completed Year>', e.g. 2006-2025. Supporting label for Long-Term CAGR.
	measure 'Long-Term CAGR Label' =
			
			FORMAT([First Reporting Year],"0")
			    & "-"
			    & FORMAT([Latest Completed Year],"0")
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: eb28b5f8-ef00-465c-a7b3-6e6225edadb5

	/// Compound Annual Growth Rate using the most recent five completed years.
	measure 'Recent CAGR' =
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR StartYear =
			    EndYear - 4
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 8d57f797-bccf-4c26-8b32-b43b8b4a2cae

	/// Displays the most recent five-completed-year range as '<Latest Completed Year minus 4>-<Latest Completed Year>', e.g. 2021-2025. Supporting label for Recent CAGR.
	measure 'Recent CAGR Label' =
			
