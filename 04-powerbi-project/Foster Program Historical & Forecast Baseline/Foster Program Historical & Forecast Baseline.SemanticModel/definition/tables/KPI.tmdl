	/// Recreates the year-end Fostered Animals forecast for a historical validation year using the Historical Completion Ratio (Validation).
	/// 
	/// Formula:
	/// 
	/// Historical YTD Fostered Animals
	/// /
	/// Historical Completion Ratio (Validation)
	/// 
	/// Used to evaluate forecast accuracy and calculate forecast error metrics.
	measure 'Historical Forecast' =
			
			VAR ValidationYear =
			    SELECTEDVALUE('Date'[Year])
			
			VAR ReportingMonth =
			    MONTH([Latest Reporting Date])
			
			VAR ValidationYTD =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = ValidationYear,
			        'Date'[Month] <= ReportingMonth
			    )
			
			RETURN
			ROUND(
			    DIVIDE(
			        ValidationYTD,
			        [Historical Completion Ratio]
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 569a0933-e0f4-45f3-ac3f-6a78eb197e49

	/// Filters forecast validation visuals to the most recent five completed reporting years.
	/// 
	/// Used to create the Forecast Validation & Accuracy table by limiting the analysis to historical years included in the forecast back-testing process.
	/// 
	/// Example:
	/// 
	/// If Latest Completed Year = 2025
	/// 
	/// Included:
	/// 2021
	/// 2022
	/// 2023
	/// 2024
	/// 2025
	/// 
	/// Excluded:
	/// 2006-2020
	/// 
	/// The filter automatically rolls forward as new completed years become available.
	/// 
	measure 'Forecast Validation Filter' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR CurrentYear =
			    SELECTEDVALUE('Date'[Year])
			
			RETURN
			IF(
			    CurrentYear >= StartYear
			        && CurrentYear <= [Latest Completed Year],
			    1,
			    0
			)
		formatString: 0
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 53d11bac-cca3-4044-9370-e742d95b25a0

	/// Percentage difference between the Historical Forecast and the actual year-end Fostered Animals count.
	/// 
	/// Formula:
	/// 
	/// (Historical Forecast - Actual)
	/// /
	/// Actual
	/// 
	/// Used to evaluate forecast accuracy for each historical validation year.
	measure 'Forecast Error %' =
			
			DIVIDE(
			    [Historical Forecast]
			        - [Fostered Animals],
			    [Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 22f6cfa3-a3ba-4db6-ba1b-a3359398b3f1

	/// Average absolute forecast error produced by the Historical Ratio Forecasting methodology across the most recent five completed reporting years.
	/// 
	/// Calculated by averaging the absolute value of annual forecast errors between the Historical Forecast and the actual year-end Fostered Animals count.
	/// 
	/// Used to evaluate forecast reliability and establish planning outlook ranges for future foster participation estimates.
	/// 
	/// Formula:
	/// 
	/// Average(
	/// ABS(2021 Forecast Error),
	/// ABS(2022 Forecast Error),
	/// ABS(2023 Forecast Error),
	/// ABS(2024 Forecast Error),
	/// ABS(2025 Forecast Error)
	/// )
	measure 'Average Forecast Error %' =
			
			AVERAGEX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= [Latest Completed Year] - 4
			            &&
			        'Date'[Year] <= [Latest Completed Year]
			    ),
			    ABS(
			        CALCULATE([Forecast Error %])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 86943a66-5ddd-40ce-8277-07107a9edb13

	/// Formatted label displaying the Average Forecast Error % used in the Forecast Validation & Accuracy section.
	/// 
	/// Provides an executive-friendly representation of forecast accuracy using average absolute error across the most recent five completed reporting years.
	/// 
	/// Example:
	/// 
	/// ±0.9%
	measure 'Average Forecast Error Label' =
			
			"±"
			    & FORMAT(
			        [Average Forecast Error %],
			        "0.0%"
			    )
		displayFolder: Q4 — Forecast Outlook\_Formatting & Display
		lineageTag: 0d670b93-a3d9-4598-86a0-6d4797703f80

	/// Hardcoded multi-bullet executive narrative for the Q4 Forecast Outlook Key Insights box. Literal text, not dynamically calculated from live measures — update manually if the underlying forecast figures change.
	measure 'Forecast Executive Insight' =
			
			"• 2026 participation is projected at approximately 4,119 fostered animals." &
			UNICHAR(10) &
			"• The forecast remains consistent with the recent operating range observed since 2021." &
			UNICHAR(10) &
			"• Historical completion-rate forecasting achieved an average validation error of approximately ±2.5%." &
			UNICHAR(10) &
			"• Current participation levels are expected to remain stable through year-end." &
			UNICHAR(10) &
			"• Foster utilization is expected to remain above 30%, consistent with the high-utilization environment observed"&
			UNICHAR(10) &"   in recent years."
		displayFolder: Q4 — Forecast Outlook\_Formatting & Display
		lineageTag: 2d8e2ecf-9b16-4223-bd1f-f4ebb6665814

	/// Historical Actuals
	/// = Actual observed values
	/// 
	/// 2026 Projection
	/// = Forecast
	/// 
	/// 2027 Outlook
	/// = Planning assumption
	measure 'Historical Actuals Series' =
			
			VAR Period =
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			
			RETURN
			SWITCH(
			    Period,
			    "2021", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2021),
			    "2022", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2022),
			    "2023", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2023),
			    "2024", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2024)
			    ,"2025", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2025)
			)
		formatString: #,0
		displayFolder: Q4 — Forecast Outlook
		lineageTag: fc1ec2fb-5596-4a54-9aed-ef4fa4169051

	/// Series value for the Historical Actuals Chart's forecast line. Returns the actual Fostered Animals count for 2025 and the Year-End Projection value for the '2026 Forecast' period, bridging the chart from the last actual year into the current-year forecast point.
	measure 'Projection Series' =
			
			VAR Period =
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			
			RETURN
			SWITCH(
			    Period,
			    "2025",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2025
			        ),
			
			    "2026 Forecast",
			        [Year-End Projection]
			)
		formatString: #,0
		displayFolder: Q4 — Forecast Outlook
		lineageTag: 3e840f04-69fe-4083-9b61-5e073568a11c

	/// Monthly Fostered Animals participation for the current reporting year.
	/// 
	/// Returns actual monthly participation values for the latest reporting year and is used to compare current performance against the 5-Year Seasonal Benchmark.
	/// 
	/// Used by:
	/// 
	/// • Typical Annual Foster Activity Pattern
	/// • Capacity Planning Benchmarks & Variance Tracker
	/// • Seasonal Operations Analysis
	measure 'Monthly Participation' =
			
			VAR ReportingYear =
			    [Latest Reporting Year]
			
			VAR CurrentMonth =
			    SELECTEDVALUE('Date'[Month])
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = ReportingYear,
			    'Date'[Month] = CurrentMonth
			)
		formatString: #,0
		displayFolder: Monthly Tracking
		lineageTag: 2a935eb6-da9f-456e-807e-74c7f343c30b

	/// Percentage difference between Monthly Participation and the 5-Year Seasonal Benchmark for the selected month.
	/// 
	/// Formula:
	/// 
	/// (Monthly Participation - 5-Year Seasonal Benchmark)
	/// /
	/// 5-Year Seasonal Benchmark
	/// 
	/// Used to compare current-year monthly foster participation against historical seasonal expectations.
	/// 
	/// Positive values indicate participation above benchmark.
	/// 
	/// Negative values indicate participation below benchmark.
	/// 
	/// Used by the Capacity Planning Benchmarks & Variance Tracker and seasonal operations analysis.
	measure 'Seasonal Benchmark Variance %' =
			
			VAR MonthlyValue = [Monthly Participation]
			RETURN
			IF(
			    ISBLANK(MonthlyValue),
			    BLANK(),
			    DIVIDE(
			        MonthlyValue - [5-Year Seasonal Benchmark],
			        [5-Year Seasonal Benchmark]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Monthly Tracking
		lineageTag: a972c641-ceed-4b05-a660-77bcd474e9ba

	/// Monthly Fostered Animals participation at the Year-Month grain.
	/// 
	/// Returns the distinct Fostered Animals count for the selected reporting month and reporting year.
	/// 
	/// Used by the Historical Seasonality Heatmap to visualize long-term seasonal patterns, growth, stabilization, and recurring demand cycles.
	measure 'Monthly Foster Participation' =
			
			[Fostered Animals]
		formatString: #,0
		displayFolder: Monthly Tracking
		lineageTag: 8d4f216f-22ae-46e5-a792-52bde3e32190

	/// Returns a hex color banded by the Fostered Animals value for the cell (gray below 600, progressing through gold and orange bands up to dark red-brown at 2000+). Used for cell shading on the Historical Seasonality Heatmap.
	measure 'Seasonality Heatmap Color' = ```
			
			VAR Value_ = [Fostered Animals]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Value_), BLANK(),
			
			    Value_ < 600,  "#D1D5DB",   -- Gray
			    Value_ < 800,  "#EEE4C8",   -- Beige
			    Value_ < 1000, "#E9D78C",   -- Light Gold
			    Value_ < 1200, "#E7B95B",   -- Gold
			    Value_ < 1400, "#E89A2A",   -- Light Orange
			    Value_ < 1600, "#D97706",   -- Orange
			    Value_ < 1800, "#B85C00",   -- Dark Orange
			    Value_ < 2000, "#8B3E00",   -- Brown
			
			    "#6B250A"                   -- Peak Activity
			)/*Seasonality Heatmap Color = 
			VAR Value_ = [Fostered Animals]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Value_), BLANK(),
			
			    Value_ < 3000,  "#D1D5DB",   -- Gray
			    Value_ < 4000,  "#EEE4C8",   -- Beige
			    Value_ < 6000,  "#E9D78C",   -- Light Gold
			    Value_ < 8000,  "#E7B95B",   -- Gold
			
			    Value_ < 9000,  "#E89A2A",   -- Light Orange
			    Value_ < 9500,  "#D97706",   -- Orange
			
			    Value_ < 10000, "#B85C00",   -- Dark Orange
			    Value_ < 10500, "#8B3E00",   -- Brown
			
			    "#6B250A"                    -- Darkest Peak
			)*/
			// VAR ValueTemp =
			//     [Monthly Foster Participation]
			
			// RETURN
			// SWITCH(
			//     TRUE(),
			
			//     ValueTemp >= 9500, "#92400E",   // Dark Brown
			
			//     ValueTemp >= 8500, "#D97706",   // Orange
			
			//     ValueTemp >= 7000, "#F59E0B",   // Amber
			
			//     ValueTemp >= 5000, "#FCD34D",   // Yellow
			
			//     ValueTemp >= 2500, "#FEF3C7",   // Light Yellow
			
			//     ValueTemp >= 1000, "#E2E8F0",   // Gray
			
			//     "#F8FAFC"                       // Light Gray
			// )
			```
		displayFolder: Monthly Tracking\_Formatting & Display
		lineageTag: 949788ff-4604-4f5f-9efc-81b7377850d9

	/// Executive-level summary of seasonal participation patterns, peak activity periods, benchmark performance, and operational planning priorities.
	/// 
	/// Provides the primary executive briefing narrative for the Capacity Planning & Seasonal Operations section.
	measure 'Seasonality Executive Conclusion' =
			
			"• 2026 foster participation has remained below the five-year seasonal benchmark across all completed months." &
			UNICHAR(10) &
			"• The largest benchmark variances occurred during February (-30.7%) and March (-31.5%), indicating a slower start to the year." &
			UNICHAR(10) &
			"• Performance improved during July (-11.6%) and August (-12.9%), reducing the gap against historical seasonal benchmarks." &
			UNICHAR(10) &
			"• Foster participation continues to follow expected seasonal patterns, with activity increasing through the summer months." &
			UNICHAR(10) &
			"• Current-year participation remains below benchmark levels but shows no significant deviation from the historical seasonal" &
			UNICHAR(10) & "  cycle."
		displayFolder: Monthly Tracking\_Formatting & Display
		lineageTag: d2558536-f212-4582-b90d-bdc06aaa035f

	/// Dynamic report title displaying the Foster Program Historical & Forecast Baseline report name and the available data period. Automatically updates based on the earliest and latest dates in the model, ensuring the report header always reflects the current reporting range without manual maintenance.
	measure 'Report Title' =
			
			VAR FirstDateKey =
			    CALCULATE(
			        MIN('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR LastDateKey =
			    CALCULATE(
			        MAX('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR StartDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], FirstDateKey
			    )
			
			VAR EndDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], LastDateKey
			    )
			
			RETURN
			    "Foster Program Historical & Forecast Baseline ( " &
			    FORMAT(StartDate,"yyyy MMM") &
			    " - " &
			    FORMAT(EndDate,"yyyy MMM") &
			    " )"
		displayFolder: KPI Scorecards\_Formatting & Display
		lineageTag: 31803443-7e8c-4081-ba19-136bf8f5340f

	/// Compound Annual Growth Rate (CAGR) during the Rapid Growth Phase (2006-2009).
	/// 
	/// Measures the annualized growth rate of Fostered Animals participation from the program's first reporting year through the end of the initial growth period.
	/// 
	/// Used to quantify the speed of program growth during the Foster Program's early development stage and to compare growth dynamics across lifecycle phases.
	/// 
	/// Formula:
	/// 
	/// (Ending Value ÷ Starting Value) ^ (1 ÷ Number of Years) - 1
	/// 
	/// Period:
	/// 
	/// 2006-2009
	/// 
	/// Business Meaning:
	/// 
	/// Represents the average annual growth rate required for Fostered Animals participation to increase from the 2006 baseline to the 2009 participation level.
	measure 'Rapid Growth Phase CAGR' =
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = 2006
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = 2009
			    )
			
			RETURN
			POWER(
			    DIVIDE(EndValue, StartValue),
			    1 / 3
			) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 9b489d61-9d77-4dd5-b6f0-6fdd2d187a0d

	/// Compound Annual Growth Rate (CAGR) during the Program Transition Phase (2010-2013).
	/// 
	/// Used to measure the annualized participation growth rate during the period following the program's early peak.
	measure 'Program Transition Phase CAGR' =
			
			VAR StartYear =
			    2010
			
			VAR EndYear =
			    2013
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 46f96181-9abb-4462-9b19-98192c588b23

	/// Compound Annual Growth Rate (CAGR) during the Stable Operations Phase (2014-2019).
	/// 
	/// Used to evaluate participation changes during the program's long-term stable operating period.
	measure 'Stable Operations CAGR' =
			
			VAR StartYear =
			    2014
			
			VAR EndYear =
			    2019
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 6325261e-d834-4a8c-8068-f9ffda11a169

	/// Compound Annual Growth Rate (CAGR) during the High Utilization Phase (2020 through the latest completed reporting year).
	/// 
	/// Used to evaluate recent participation trends within the program's current operating era.
	measure 'High Utilization Phase CAGR' =
			
			VAR StartYear =
			    2020
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR StartValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			VAR NumberOfYears =
			    EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(
			        DIVIDE(
			            EndValue,
			            StartValue
			        ),
			        DIVIDE(1, NumberOfYears)
			    ) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 8ed1f172-8e3a-4a28-bebb-0fbcdc8a4d89

	/// Literal label text 'Rapid Growth (2006-09)'. Used as the Rapid Growth phase band's title on the Q1 chart.
	measure 'Rapid Growth Phase CAGR Label' =
			
