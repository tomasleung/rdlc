	/// Supporting narrative describing the historical period, forecast year, and planning horizon included in the Forecast Outlook section.
	/// 
	/// Provides context for the historical actuals trend, current-year projection, and next-year planning outlook.
	measure 'Forecast Outlook Description' = ```
			
			FORMAT([Latest Reporting Year] - 5, "0") & " - " 
			    & FORMAT([Latest Reporting Year]-1, "0")
			    & " Fostered Animals and  "
			    & FORMAT([Latest Reporting Year] , "0")
			    & " Forecast."
			
			```
		displayFolder: Forecast Outlook
		lineageTag: c132c51f-3de5-40cb-bad3-03f8248f37f1

	/// Recreates the year-end Fostered Animals forecast for a historical validation year using the Historical Completion Ratio (Validation).
	/// 
	/// Formula:
	/// 
	/// Historical YTD Fostered Animals
	/// /
	/// Historical Completion Ratio (Validation)
	/// 
	/// Used to evaluate forecast accuracy and calculate forecast error metrics.
	measure 'Historical Forecast' =
			
			VAR ValidationYear =
			    SELECTEDVALUE('Date'[Year])
			
			VAR ReportingMonth =
			    MONTH([Latest Reporting Date])
			
			VAR ValidationYTD =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = ValidationYear,
			        'Date'[Month] <= ReportingMonth
			    )
			
			RETURN
			ROUND(
			    DIVIDE(
			        ValidationYTD,
			        [Historical Completion Ratio]
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Forecast Outlook
		lineageTag: 569a0933-e0f4-45f3-ac3f-6a78eb197e49

	/// Filters forecast validation visuals to the most recent five completed reporting years.
	/// 
	/// Used to create the Forecast Validation & Accuracy table by limiting the analysis to historical years included in the forecast back-testing process.
	/// 
	/// Example:
	/// 
	/// If Latest Completed Year = 2025
	/// 
	/// Included:
	/// 2021
	/// 2022
	/// 2023
	/// 2024
	/// 2025
	/// 
	/// Excluded:
	/// 2006-2020
	/// 
	/// The filter automatically rolls forward as new completed years become available.
	/// 
	measure 'Forecast Validation Filter' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR CurrentYear =
			    SELECTEDVALUE('Date'[Year])
			
			RETURN
			IF(
			    CurrentYear >= StartYear
			        && CurrentYear <= [Latest Completed Year],
			    1,
			    0
			)
		formatString: 0
		displayFolder: Forecast Outlook
		lineageTag: 53d11bac-cca3-4044-9370-e742d95b25a0

	/// Percentage difference between the Historical Forecast and the actual year-end Fostered Animals count.
	/// 
	/// Formula:
	/// 
	/// (Historical Forecast - Actual)
	/// /
	/// Actual
	/// 
	/// Used to evaluate forecast accuracy for each historical validation year.
	measure 'Forecast Error %' =
			
			DIVIDE(
			    [Historical Forecast]
			        - [Fostered Animals],
			    [Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Forecast Outlook
		lineageTag: 22f6cfa3-a3ba-4db6-ba1b-a3359398b3f1

	/// Formatted display label showing forecast error of the Historical Ratio Forecasting methodology.
	/// 
	/// Used in executive reporting and forecast validation sections.
	/// 
	/// Example:
	/// 
	/// ±0.9%
	measure 'Forecast Error Label' =
			
			"±" &
			FORMAT(
			    [Forecast Error %],
			    "0.0%"
			)
		displayFolder: Forecast Outlook
		lineageTag: 4c5c6d0f-6edd-4170-8546-a503c0ca2ca5

	/// Average absolute forecast error produced by the Historical Ratio Forecasting methodology across the most recent five completed reporting years.
	/// 
	/// Calculated by averaging the absolute value of annual forecast errors between the Historical Forecast and the actual year-end Fostered Animals count.
	/// 
	/// Used to evaluate forecast reliability and establish planning outlook ranges for future foster participation estimates.
	/// 
	/// Formula:
	/// 
	/// Average(
	/// ABS(2021 Forecast Error),
	/// ABS(2022 Forecast Error),
	/// ABS(2023 Forecast Error),
	/// ABS(2024 Forecast Error),
	/// ABS(2025 Forecast Error)
	/// )
	measure 'Average Forecast Error %' =
			
			AVERAGEX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= [Latest Completed Year] - 4
			            &&
			        'Date'[Year] <= [Latest Completed Year]
			    ),
			    ABS(
			        CALCULATE([Forecast Error %])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Forecast Outlook
		lineageTag: 86943a66-5ddd-40ce-8277-07107a9edb13

	/// Formatted label displaying the Average Forecast Error % used in the Forecast Validation & Accuracy section.
	/// 
	/// Provides an executive-friendly representation of forecast accuracy using average absolute error across the most recent five completed reporting years.
	/// 
	/// Example:
	/// 
	/// ±0.9%
	measure 'Average Forecast Error Label' =
			
			"±"
			    & FORMAT(
			        [Average Forecast Error %],
			        "0.0%"
			    )
		displayFolder: Forecast Outlook
		lineageTag: 0d670b93-a3d9-4598-86a0-6d4797703f80

	/// Lower bound of the planning outlook range based on the Year-End Projection and Average Forecast Error %.
	/// 
	/// Represents a reasonable lower planning assumption for the next planning year.
	measure 'Planning Outlook Low' =
			
			ROUND(
			    [Year-End Projection]
			        * (1 - [Average Forecast Error %]),
			    0
			)
		displayFolder: Forecast Outlook
		lineageTag: 4a53790e-0d11-4936-a9fb-c7398a3785b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Upper bound of the planning outlook range based on the Year-End Projection and Average Forecast Error %.
	/// 
	/// Represents a reasonable upper planning assumption for the next planning year.
	measure 'Planning Outlook High' =
			
			ROUND(
			    [Year-End Projection]
			        * (1 + [Average Forecast Error %]),
			    0
			)
		displayFolder: Forecast Outlook
		lineageTag: 58592a09-b4ec-46f8-a71e-afbb5a5ed8f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Formatted planning range for the next planning year based on Year-End Projection and Average Forecast Error %.
	/// 
	/// Example:
	/// 
	/// 12,700–12,900
	measure 'Planning Outlook Label' =
			
			FORMAT(
			    [Planning Outlook Low],
			    "#,0"
			)
			& "–" &
			FORMAT(
			    [Planning Outlook High],
			    "#,0"
			)
		displayFolder: Forecast Outlook
		lineageTag: 4cc4865a-a06d-4b63-9656-5136be69ee84

	/// Forecast Executive Insight
	measure 'Forecast Executive Insight' =
			
			"• 2026 participation is projected at approximately 12,775 fostered animals." &
			UNICHAR(10) &
			"• The projection aligns closely with 2025 actual participation (12,778 animals)." &
			UNICHAR(10) &
			"• Historical forecast validation produced an average error of approximately ±0.9%." &
			UNICHAR(10) &
			"• Current trends indicate participation levels are expected to remain stable through year-end." &
			UNICHAR(10) &
			"• Preliminary planning assumptions suggest similar participation levels in 2027."
		displayFolder: Forecast Outlook
		lineageTag: 2d8e2ecf-9b16-4223-bd1f-f4ebb6665814

	/// Mid point of the planning outlook range based on the Year-End Projection and Average Forecast Error %.
	/// 
	/// Represents a reasonable lower planning assumption for the next planning year.
	measure 'Planning Outlook Midpoint' =
			
			ROUND(
			    DIVIDE(
			        [Planning Outlook Low] + [Planning Outlook High],
			        2
			    ),
			    0
			)
		displayFolder: Forecast Outlook
		lineageTag: 8c70202b-7cd2-4480-9696-f25796f704ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns the value plotted on the Forecast Outlook trend chart.
	/// 
	/// The measure combines historical actual participation, the current year projection, and the next-year planning outlook into a single chart series.
	/// 
	/// Period logic:
	/// 
	/// • 2021-2025
	/// Returns actual annual Fostered Animals.
	/// 
	/// • 2026 (Proj.)
	/// Returns Year-End Projection.
	/// 
	/// • 2027 (Outlook)
	/// Returns Planning Outlook Midpoint.
	/// 
	/// Used exclusively by the Forecast Outlook visualization to display the transition from historical performance to projected participation and future planning assumptions.
	/// `
	measure 'Forecast Outlook Value' =
			
			VAR Period =
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			
			RETURN
			SWITCH(
			    Period,
			
			    "2021",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2021
			        ),
			
			    "2022",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2022
			        ),
			
			    "2023",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2023
			        ),
			
			    "2024",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2024
			        ),
			
			    "2025",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2025
			        ),
			
			    "2026 (Proj.)",
			        [Year-End Projection],
			
			    "2027 (Outlook)",
			        [Planning Outlook Midpoint]
			)
		displayFolder: Forecast Outlook
		lineageTag: 237737e7-f3e6-4df3-9291-75704f9cafd3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Historical Actuals
	/// = Actual observed values
	/// 
	/// 2026 Projection
	/// = Forecast
	/// 
	/// 2027 Outlook
	/// = Planning assumption
	measure 'Historical Actuals Series' =
			
			VAR Period =
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			
			RETURN
			SWITCH(
			    Period,
			    "2021", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2021),
			    "2022", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2022),
			    "2023", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2023),
			    "2024", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2024)
			    ,"2025", CALCULATE([Fostered Animals], REMOVEFILTERS('Date'), 'Date'[Year] = 2025)
			)
		formatString: #,0
		displayFolder: Forecast Outlook
		lineageTag: fc1ec2fb-5596-4a54-9aed-ef4fa4169051

	/// Historical Actuals
	/// = Actual observed values
	/// 
	/// 2026 Projection
	/// = Forecast
	/// 
	/// 2027 Outlook
	/// = Planning assumption
	measure 'Projection Series' =
			
			VAR Period =
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			
			RETURN
			SWITCH(
			    Period,
			    "2025",
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = 2025
			        ),
			
			    "2026 Forecast",
			        [Year-End Projection]
			)
		formatString: #,0
		displayFolder: Forecast Outlook
		lineageTag: 3e840f04-69fe-4083-9b61-5e073568a11c

	/// Historical Actuals
	/// = Actual observed values
	/// 
	/// 2026 Projection
	/// = Forecast
	/// 
	/// 2027 Outlook
	/// = Planning assumption
	measure 'Planning Outlook Series' =
			
			IF(
			    SELECTEDVALUE('Forecast Outlook Axis'[Period])
			        = "2027 (Outlook)",
			    [Planning Outlook Midpoint]
			)
		displayFolder: Forecast Outlook
		lineageTag: 1ab6c5ba-0455-4c74-864f-7f61c41af8d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Executive-level summary combining growth analysis, seasonality, recent operating stability, and forecast outlook into a single decision-oriented narrative.
	/// 
	/// Used as the final executive takeaway for the Foster Program Executive Dashboard.
	measure 'Executive Conclusion' = ```
			
			"• Growth: Program growth occurred primarily between 2006 and "
			    & FORMAT([Peak Year], "0")
			    & ", after which participation stabilized within a mature operating range."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "• Seasonality: Foster activity follows a predictable seasonal pattern, with peak participation occurring between "
			    & [Peak Season Start Month]
			    & " and "
			    & [Peak Season End Month]
			    & "."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "• Recent Performance: Recent participation levels remain aligned with historical operating ranges and support continued operational stability."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "• Forecast Outlook: Historical Ratio Forecasting projects approximately "
			    & FORMAT([Year-End Projection], "#,0")
			    & " fostered animals for "
			    & FORMAT([Latest Reporting Year], "0")
			    & "."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "• Forecast Confidence: Historical forecast validation produced an average error of ±"
			    & FORMAT([Average Forecast Error %], "0.0%")
			    & ", providing confidence in the current projection and future planning assumptions."
			
			```
		displayFolder: Executive Briefing
		lineageTag: 0af8098f-88ac-4d68-9409-a77057e29932

	/// Total Fostered Animals participation during the Expansion Phase from 2006 through 2009.
	/// 
	/// Calculated by summing annual Fostered Animals values across all years within the Expansion Phase.
	/// 
	/// Used for lifecycle era comparison and historical program growth analysis.
	measure 'Expansion Phase Fostered Animals' =
			
			SUMX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= 2006
			            &&
			        'Date'[Year] <= 2009
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Lifecycle Analysis
		lineageTag: 93715775-08bc-43f5-a604-531bb87a00d2

	/// Total Fostered Animals participation during the Peak Activity Phase from 2010 through 2014.
	/// 
	/// Calculated by summing annual Fostered Animals values across all years within the Peak Activity phase.
	/// 
	/// Used to identify the historical peak operating era.
	/// 
	measure 'Peak Activity Fostered Animals' =
			
			SUMX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= 2010
			            &&
			        'Date'[Year] <= 2014
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Lifecycle Analysis
		lineageTag: f7f8e29c-2114-448a-a333-95c81af410d0

	/// Total Fostered Animals participation during the Stable Operations Phase from 2015 through 2019.
	/// 
	/// Calculated by summing annual Fostered Animals values across all years within the Stable Operations phase.
	measure 'Stable Operations Fostered Animals' =
			
			SUMX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= 2015
			            &&
			        'Date'[Year] <= 2019
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Lifecycle Analysis
		lineageTag: 32433ca4-83b5-4a12-9b9a-38f15ed44bbe

	/// Total Fostered Animals participation during the Mature Program Phase from 2020 through 2025.
	/// 
	/// Calculated by summing annual Fostered Animals values across all years within the Mature Program phase.
	/// 
	/// Used as the comparison baseline against the historical peak era.
	/// ``
	measure 'Mature Program Fostered Animals' =
			
			SUMX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= 2020
			            &&
			        'Date'[Year] <= [Latest Completed Year]
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Lifecycle Analysis
		lineageTag: 5fc0363f-0255-43ca-ad79-e6a9837e96a3

	/// Returns the lifecycle era with the highest total Fostered Animals volume.
	/// 
	/// Used by the Largest Era KPI card and lifecycle analysis.
	measure 'Largest Era Name' =
			
			VAR Expansion = [Expansion Phase Fostered Animals]
			VAR Peak = [Peak Activity Fostered Animals]
			VAR Stable = [Stable Operations Fostered Animals]
			VAR Mature = [Mature Program Fostered Animals]
			
			VAR LargestValue =
			    MAX(
			        MAX(Expansion, Peak),
			        MAX(Stable, Mature)
			    )
			
			RETURN
			SWITCH(
			    LargestValue,
			    Expansion, "Expansion Phase",
			    Peak, "Peak Activity Phase",
			    Stable, "Stable Operations Phase",
			    Mature, "Mature Program Phase"
			)
		displayFolder: Lifecycle Analysis
		lineageTag: 4b18c014-ee4a-4a98-8954-8defaa7f9014

	/// Returns the total Fostered Animals value associated with the largest lifecycle era.
	measure 'Largest Era Fostered Animals' =
			
			MAX(
			    MAX(
			        [Expansion Phase Fostered Animals],
			        [Peak Activity Fostered Animals]
			    ),
			    MAX(
			        [Stable Operations Fostered Animals],
			        [Mature Program Fostered Animals]
			    )
			)
		formatString: 0
		displayFolder: Lifecycle Analysis
		lineageTag: ac61205e-782a-4f47-be13-c8a180402ca3

	/// Returns the current lifecycle era used for executive comparison.
	/// 
	/// Represents the most recent completed operating period.
	measure 'Current Era Name' =
			
			"Mature Program Phase"
		displayFolder: Lifecycle Analysis
		lineageTag: 768f076a-1e58-4f8e-aba2-ed9b405ae11c

	/// Percentage difference between the Mature Program Phase and the Peak Activity Phase.
	/// 
	/// Used to quantify how close current activity remains to historical peak participation.
	/// 
	measure 'Current vs Peak Era %' =
			
			DIVIDE(
			    [Current Era Fostered Animals]
			        - [Peak Activity Fostered Animals],
			    [Peak Activity Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Lifecycle Analysis
		lineageTag: 154a485b-9fec-47ec-87ba-de1e537bcbb1

	/// Executive interpretation of the Current vs Peak Era comparison.
	measure 'Current vs Peak Era Label' =
			
			IF(
			    ABS([Current vs Peak Era %]) <= 0.10,
			    "Current activity remains close to peak",
			    "Current activity is materially below peak"
			)
		displayFolder: Lifecycle Analysis
		lineageTag: 8b93e314-935b-4c5c-9420-95831074ba8f

	/// Executive narrative summarizing lifecycle era performance, historical peak activity, and current operating maturity.
	measure 'Growth Analysis Executive Insight' =
			
			"The Foster Program underwent rapid expansion between 2006 and 2010, leading to a peak activity period between 2010 and 2014. Although annual participation has moderated slightly from its historical peak, program activity has remained remarkably stable over the last decade."
			
			& UNICHAR(10) & UNICHAR(10)
			
			& "The current Mature Program Phase (2020-"
			& FORMAT([Latest Completed Year], "0")
			& ") supported "
			& FORMAT([Current Era Fostered Animals], "#,0")
			& " foster animals, which is only "
			& FORMAT(ABS([Current vs Peak Era %]), "0.0%")
			& " below the historical peak era. These results indicate that the Foster Program has successfully transitioned from a growth phase into a mature and sustainable operating model."
		displayFolder: Lifecycle Analysis
		lineageTag: 305dae0b-0f50-4bf9-bd50-ff92365e3d93

	/// Total Fostered Animals participation during the current lifecycle era (Mature Program Phase).
	/// 
	/// Represents the cumulative number of Fostered Animals from 2020 through the most recent completed reporting year.
	/// 
	/// Used to quantify current operating performance and compare the Mature Program Phase against the historical Peak Activity Phase.
	/// 
	/// The measure serves as the primary value for Current Era KPI cards, lifecycle comparisons, and executive growth analysis.
	measure 'Current Era Fostered Animals' = ```
			
			[Mature Program Fostered Animals]
			
			```
		formatString: 0
		displayFolder: Lifecycle Analysis
		lineageTag: 038cb690-9a31-45e5-ba95-cc2751f39817

	/// Formatted label displaying the lifecycle era with the highest total Fostered Animals participation and the associated volume.
	/// 
	/// Used to support executive lifecycle analysis and provide a concise summary of the program's highest-volume operating era.
	/// 
	/// Example:
	/// 
	/// Peak Activity Phase: 38,844
	measure 'Largest Era Label' =
			
			[Largest Era Name]
			    & ": "
			    & FORMAT(
			        [Largest Era Fostered Animals],
			        "#,0"
			    )
		displayFolder: Lifecycle Analysis
		lineageTag: 11ccc8a6-2c6f-4e77-b3e3-c7b0f5e5bd6f

	/// Returns the total Fostered Animals participation for the selected lifecycle era.
	/// 
	/// Maps the Lifecycle Era dimension to the corresponding era-specific Fostered Animals measure and enables a single measure to drive the Era Comparison chart.
	/// 
	/// The measure is used with the disconnected Lifecycle Era table to display:
	/// 
	/// • Expansion Phase (2006-2009)
	/// • Peak Activity (2010-2014)
	/// • Stable Operations (2015-2019)
	/// • Mature Program (2020-Latest Completed Year)
	/// 
	/// Used by the Era Comparison (Total Volume) visual and lifecycle analysis reporting.
	measure 'Era Fostered Animals' =
			
			SWITCH(
			    SELECTEDVALUE('Lifecycle Era'[Era]),
			
			    "Expansion Phase (2006-09)",
			        [Expansion Phase Fostered Animals],
			
			    "Peak Activity (2010-14)",
			        [Peak Activity Fostered Animals],
			
			    "Stable Ops (2015-19)",
			        [Stable Operations Fostered Animals],
			
			    "Mature Program (2020-25)",
			        [Mature Program Fostered Animals]
			)
		formatString: #,0
		displayFolder: Lifecycle Analysis
		lineageTag: 55d96758-c0f8-4ae4-8e31-d3d6be1d8a41

	/// Monthly Fostered Animals participation for the current reporting year.
	/// 
	/// Returns actual monthly participation values for the latest reporting year and is used to compare current performance against the 5-Year Seasonal Benchmark.
	/// 
	/// Used by:
	/// 
	/// • Typical Annual Foster Activity Pattern
	/// • Capacity Planning Benchmarks & Variance Tracker
	/// • Seasonal Operations Analysis
	measure 'Monthly Participation' =
			
			VAR ReportingYear =
			    [Latest Reporting Year]
			
			VAR CurrentMonth =
			    SELECTEDVALUE('Date'[Month])
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = ReportingYear,
			    'Date'[Month] = CurrentMonth
			)
		formatString: #,0
		displayFolder: Seasonal Operations
		lineageTag: 2a935eb6-da9f-456e-807e-74c7f343c30b

	/// Percentage difference between Monthly Participation and the 5-Year Seasonal Benchmark for the selected month.
	/// 
	/// Formula:
	/// 
	/// (Monthly Participation - 5-Year Seasonal Benchmark)
	/// /
	/// 5-Year Seasonal Benchmark
	/// 
	/// Used to compare current-year monthly foster participation against historical seasonal expectations.
	/// 
	/// Positive values indicate participation above benchmark.
	/// 
	/// Negative values indicate participation below benchmark.
	/// 
	/// Used by the Capacity Planning Benchmarks & Variance Tracker and seasonal operations analysis.
	measure 'Seasonal Benchmark Variance %' =
			
			VAR MonthlyValue = [Monthly Participation]
			RETURN
			IF(
			    ISBLANK(MonthlyValue),
			    BLANK(),
			    DIVIDE(
			        MonthlyValue - [5-Year Seasonal Benchmark],
			        [5-Year Seasonal Benchmark]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonal Operations
		lineageTag: a972c641-ceed-4b05-a660-77bcd474e9ba

	/// Assigns a planning priority classification to each month based on established seasonal operating patterns.
	/// 
	/// Priority categories indicate the relative level of planning effort required during the month.
	/// 
	/// Used by the Capacity Planning Benchmarks & Variance Tracker.
	measure 'Planning Priority' =
			
			VAR CurrentMonth =
			    SELECTEDVALUE('Date'[Month])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    CurrentMonth IN {1,2},
			        "Low",
			
			    CurrentMonth IN {3,4,11,12},
			        "Moderate",
			
			    CurrentMonth IN {9,10},
			        "Elevated",
			
			    CurrentMonth IN {5,6,7,8},
			        "High"
			)
		displayFolder: Seasonal Operations
		lineageTag: 5d89cfc4-a888-4e24-a70a-46322ab565cd

	/// Returns the designated color associated with each Planning Priority category.
	/// 
	/// Used for conditional formatting within the Capacity Planning Benchmarks & Variance Tracker.
	/// 
	measure 'Planning Priority Color' =
			
			SWITCH(
			    [Planning Priority],
			
			    "Low", "#2563EB",
			    "Moderate", "#6366F1",
			    "Elevated", "#10B981",
			    "High", "#D97706"
			)
		displayFolder: Seasonal Operations
		lineageTag: 35351366-7535-4bc3-93de-67d59839d534

	/// Monthly Fostered Animals participation at the Year-Month grain.
	/// 
	/// Returns the distinct Fostered Animals count for the selected reporting month and reporting year.
	/// 
	/// Used by the Historical Seasonality Heatmap to visualize long-term seasonal patterns, growth, stabilization, and recurring demand cycles.
	measure 'Monthly Foster Participation' =
			
			[Fostered Animals]
		formatString: #,0
		displayFolder: Seasonal Operations
