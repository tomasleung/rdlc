	/// Filters visuals to completed reporting years only.
	/// 
	/// Used to exclude the current in-progress reporting year from historical trend charts, CAGR calculations, and lifecycle analysis visuals.
	/// 
	/// Example:
	/// 
	/// Latest Reporting Year = 2026
	/// 
	/// Included:
	/// 2006-2025
	/// 
	/// Excluded:
	/// 2026
	measure 'Completed Year Filter' =
			
			IF(
			    SELECTEDVALUE('Date'[Year])
			        <= [Latest Completed Year],
