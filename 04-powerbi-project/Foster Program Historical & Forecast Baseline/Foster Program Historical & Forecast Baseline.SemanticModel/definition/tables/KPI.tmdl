	measure 'Monthly Performance Status' =
			
			VAR VariancePct =
			    ABS([Monthly Benchmark Variance %])
			RETURN
			    SWITCH(
			        TRUE(),
			        VariancePct <= 0.10, "🟢 On Target",
			        VariancePct <= 0.15, "🟡 Monitor",
