table KPI
	lineageTag: f21f34b4-0bca-4308-a582-061f466099e5

	/// Count of separate foster stays (each trip an animal takes to a foster home),
	/// regardless of whether the same animal was placed more than once.
	/// An animal placed twice contributes 2, not 1.
	measure 'Foster Placement Count' =
			
			COUNTROWS('Foster Placements')
		formatString: #,0
		displayFolder: Capacity & Support
		lineageTag: 265073c5-4c17-4908-ba28-40c17c6adc58

	/// Distinct animals that participated in foster care during the selected reporting period.
	/// 
	/// Uses the Foster Animal Month snapshot table where one row represents one animal participating in foster care during a given month.
	/// 
	/// This is the primary Foster Program KPI and should be used for monthly, quarterly, yearly, benchmark, and forecasting analysis.
	measure 'Fostered Animals' =
			
			DISTINCTCOUNT(
			    'Foster Animal Month'[SB Animal ID]
			)
		formatString: #,0
		displayFolder: Capacity & Support
		lineageTag: d732fd26-42f8-48dd-b47c-ccfd13c7e5f1

	/// Distinct animals currently in foster care.
	/// 
	/// Uses the active foster placement indicator.
	measure 'Current Foster Animals' =
			
			CALCULATE(
			    DISTINCTCOUNT(
			        'Foster Placements'[SB Animal ID]
			    ),
			    'Foster Placements'[Currently In Foster] = 1
			)
		formatString: #,0
		displayFolder: Capacity & Support
		lineageTag: 6c5646a8-68b5-4b74-817a-3ea9cdfbc369

	/// Average number of days animals spend in foster care.
	measure 'Average Foster Duration' =
			
			AVERAGE(
			    'Foster Placements'[Foster Duration (Days)]
			)
		formatString: #,0.0
		displayFolder: Duration
		lineageTag: 0b8520eb-fa5d-48da-800f-95194b0cc71c

	/// Latest reporting month available in the Foster Animal Month snapshot fact table.
	/// 
	/// Used to anchor benchmark, YTD, and forecasting calculations to the most recent complete foster reporting period.
	/// 
	/// The measure should always derive from the foster snapshot fact rather than the Date table to avoid selecting periods with no foster activity.
	measure 'Latest Reporting Date' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			RETURN
			LOOKUPVALUE(
			    'Date'[Date],
			    'Date'[Date Key], LatestMonthKey
			)
		formatString: General Date
		displayFolder: Capacity & Support\Historical Foster Animals
		lineageTag: ddc40fe2-e0af-4444-9553-02ea909393d9

	/// Latest reporting year available in the Foster Animal Month snapshot fact table.
	/// 
	/// Used to determine the current in-progress year and completed reporting periods.
	measure 'Latest Reporting Year' = ```
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			RETURN
			    LOOKUPVALUE(
			        'Date'[Year],
			        'Date'[Date Key], LatestMonthKey
			    )
			
			```
		formatString: 0
		displayFolder: Capacity & Support\Historical Foster Animals
		lineageTag: e05e31ed-95f6-4118-bc25-a49e4c6dbd5a

	/// Percentage growth in annual foster participation between the first reporting year and the most recent completed reporting year.
	measure 'Program Growth' =
			
			VAR StartYear =
			    [First Reporting Year]
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR StartYearValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = StartYear
			    )
			
			VAR EndYearValue =
			    CALCULATE(
			        [Fostered Animals],
			        REMOVEFILTERS('Date'),
			        'Date'[Year] = EndYear
			    )
			
			RETURN
			DIVIDE(
			    EndYearValue - StartYearValue,
			    StartYearValue
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Program Growth
		lineageTag: d4f6e9d1-c1d2-4ec9-83a6-156bfa429b99

	/// Total annual foster participation across all completed reporting years.
	/// 
	/// Calculated as the sum of yearly Fostered Animals values.
	/// 
	/// An animal participating in multiple years contributes once per year
	measure 'Historical Fostered Animals' =
			
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date')
			)
		formatString: #,0
		displayFolder: Capacity & Support\Historical Foster Animals
		lineageTag: db1a08bc-809a-4d42-943e-157cc0b78878

	/// Earliest reporting year available in the Foster Animal Month snapshot fact table.
	/// 
	/// Used for KPI labels and historical reporting ranges.
	measure 'First Reporting Year' =
			
			VAR FirstMonthKey =
			    MINX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			RETURN
			    LOOKUPVALUE(
			        'Date'[Year],
			        'Date'[Date Key], FirstMonthKey
			    )
		formatString: 0
		displayFolder: Capacity & Support\Historical Foster Animals
		lineageTag: d7a6a883-73d8-4606-be1e-225139e32ff5

	/// Dynamic subtitle for the Historical Foster Animals KPI.
	/// 
	/// Displays the completed reporting period used in the calculation.
	measure 'Historical Participation Label' = ```
			
			
			VAR FirstDateKey =
			    CALCULATE(
			        MIN('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR LastDateKey =
			    CALCULATE(
			        MAX('Foster Animal Month'[Month Date Key]),
			        REMOVEFILTERS('Foster Animal Month')
			    )
			
			VAR StartDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], FirstDateKey
			    )
			
			VAR EndDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key], LastDateKey
			    )
			
			RETURN
			    UNICHAR(10) &  FORMAT(StartDate,"yyyy MMM") &
			    " - " &
			    FORMAT(EndDate,"yyyy MMM") &
			    " Foster Participation"
			
			
			```
		displayFolder: Capacity & Support\Historical Foster Animals
		lineageTag: b8172630-09f3-4196-bc04-2426401a1021

	/// Annual Fostered Animals count for the first reporting year.
	measure 'Baseline Fostered Animals' =
			
			VAR StartYear =
			    [First Reporting Year]
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = StartYear
			)
		formatString: #,0
		displayFolder: Capacity & Support\Program Growth
		lineageTag: b9796ea5-ef0e-4ea5-b8a2-6603f74d7d31

	/// Annual Fostered Animals count for the most recent completed reporting year.
	measure 'Latest Completed Year Fostered Animals' =
			
			VAR EndYear =
			    [Latest Reporting Year] - 1
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = EndYear
			)
		formatString: #,0
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 6f91e25a-848c-4c0a-b6b0-6afa970d7382

	/// Latest completed year available in the Foster Animal Month snapshot fact table.
	/// 
	/// Used to anchor benchmark, YTD, and forecasting calculations to the most recent complete foster reporting period.
	/// 
	/// The measure should always derive from the foster snapshot fact rather than the Date table to avoid selecting periods with no foster activity.
	measure 'Latest Completed Year' =
			
			[Latest Reporting Year] - 1
		formatString: 0
		displayFolder: Capacity & Support\Program Growth
		lineageTag: 7d376ee8-170f-45e2-998a-5d083fc77f7a

	/// Displays the first reporting year and most recent completed reporting year with their corresponding Fostered Animals values.
	/// 
	/// Used as the supporting context label beneath Program Growth.
	measure 'Program Growth Label' =
			
			VAR StartYear =
			    [First Reporting Year]
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR StartValue =
			    [Baseline Fostered Animals]
			
			VAR EndValue =
			    [Latest Completed Year Fostered Animals]
			
			RETURN
			UNICHAR(10) & FORMAT(StartYear, "0")
			    & ": "
			    & FORMAT(StartValue, "#,0")
			    & " → "
			    & FORMAT(EndYear, "0")
			    & ": "
			    & FORMAT(EndValue, "#,0")
		displayFolder: Capacity & Support\Program Growth
