	/// Hardcoded multi-bullet executive narrative for the Q1 Growth Trend Key Insights box. Literal text, not dynamically calculated from live measures. Note: the displayed text still references the old 'Expansion Phase' name even though the phase was renamed to 'Rapid Growth' everywhere else — the narrative content itself needs a manual update, separate from this description fix.
	measure 'Grown Insight' =
			
			"• Foster participation grew from 5,717 animals in 2006 to a peak of 7,964 animals in 2009." &
			UNICHAR(10) &
			"• Growth was concentrated during the Expansion Phase (2006–2009), with a CAGR of +11.7%." &
			UNICHAR(10) &
			"• Since the 2009 peak, annual participation has generally declined, reaching 4,314 animals by 2025." &
			UNICHAR(10) &
			"• Long-term participation has decreased at an average annual rate of -1.47% since 2006." &
			UNICHAR(10) &
			"• Recent trends show a steeper decline (-2.61% CAGR, 2021–2025), though foster utilization of shelter intakes has actually improved to over 30%."
		displayFolder: Q1 — Growth Trend\_Formatting & Display
		lineageTag: 13e8e1cf-89f4-46e3-bfc5-a9c8ac9533c4

	/// Returns a hex color based on Forecast Error % for conditional formatting on the Forecast Validation table. Red when the historical forecast underestimated the actual by 1% or more; green otherwise (including when the forecast overestimated or was within ±1% of actual).
	measure 'Forecast Error Color' =
			
			VAR ErrorPct = [Forecast Error %]
			RETURN
			SWITCH(
			    TRUE(),
			    ErrorPct <= -0.01, "#16A34A",   -- Green
			    ErrorPct >= 0.01, "#DC2626",    -- Red
			    "#16A34A"                       -- Gray
			)
		displayFolder: Q4 — Forecast Outlook\_Formatting & Display
		lineageTag: bea6eeae-35aa-4f4c-93f2-1870aa10e199

	/// Lowest monthly Fostered Animals count observed during the current reporting year. Used alongside Current Year Lowest Month to identify the period of lowest foster activity within the current operating year.
	measure 'Current Year Lowest Month Fostered Animals' =
			
			VAR ReportingYear =
			    [Latest Reporting Year]
			
			VAR MonthTable =
			    SUMMARIZE(
			        FILTER(
			            ALL('Date'),
			            'Date'[Year] = ReportingYear
			        ),
			        'Date'[Month],
			        "AnimalCount", [Fostered Animals]
			    )
			
			RETURN
			MINX(
			    MonthTable,
			    [AnimalCount]
			)
		formatString: #,0
		displayFolder: Q3 — Seasonality
		lineageTag: 77d7f01f-78d8-4562-a52a-789d4c83e25e

	/// Returns the month name with the lowest Monthly Participation value during the current reporting year. Used by the Lowest Month card on Current-Year Monitoring.
	measure 'Current Year Lowest Month' =
			
			VAR MonthTable =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    )
			
			VAR LowestMonthNumber =
			    MINX(
			        TOPN(
			            1,
			            MonthTable,
			            [MonthlyValue], ASC,
			            'Date'[Month], ASC
			        ),
			        'Date'[Month]
			    )
			
			RETURN
			CALCULATE(
			    MAX('Date'[Month Name]),
			    ALL('Date'),
			    'Date'[Month] = LowestMonthNumber
			)
		displayFolder: Q3 — Seasonality\_Formatting & Display
		lineageTag: 6878319a-31fe-43e8-b502-ef94dad90664

	/// Returns the month with the highest Fostered Animals participation during the latest reporting year.
	/// 
	/// The measure evaluates monthly Fostered Animals counts within the current reporting year and returns the corresponding month name associated with the highest participation level.
	measure 'Current Year Peak Month' =
			
			VAR MonthTable =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    )
			
			VAR PeakMonthNumber =
			    MINX(
			        TOPN(
			            1,
			            MonthTable,
			            [MonthlyValue], DESC,
			            'Date'[Month], ASC
			        ),
			        'Date'[Month]
			    )
			
			RETURN
			CALCULATE(
			    MAX('Date'[Month Name]),
			    ALL('Date'),
			    'Date'[Month] = PeakMonthNumber
			)
		displayFolder: Q3 — Seasonality\_Formatting & Display
		lineageTag: cf644f21-6e7e-46b0-973d-80476c9a0d78

	/// Returns the highest monthly Fostered Animals participation value observed during the latest reporting year.
	/// 
	/// Used together with Current Year Peak Month to identify the period of highest foster activity within the current operating year.
	measure 'Current Year Peak Month Fostered Animals' =
			
			MAXX(
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    ),
			    [MonthlyValue]
			)
		formatString: #,0
		displayFolder: Q3 — Seasonality
		lineageTag: be1f8b7b-4134-48e1-92e6-206aaf1c5f63

	/// Measures the percentage difference between the highest and lowest monthly Fostered Animals participation values observed during the latest reporting year.
	/// 
	/// Used to quantify seasonal variation within the current operating year and assess the magnitude of monthly participation fluctuations.
	measure 'Current Year Seasonal Variation %' = ```
			
			DIVIDE(
			    [Current Year Peak Month Fostered Animals]
			        - [Current Year Lowest Month Fostered Animals],
			    [Current Year Lowest Month Fostered Animals]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q3 — Seasonality
		lineageTag: 42984403-3b49-4a23-829b-aebf9523811e

	/// Returns a hex color based on Seasonal Benchmark Variance % for conditional formatting. Red when variance is negative (below benchmark); green when variance is zero or positive (at or above benchmark).
	measure 'Seasonal Benchmark Variance Color' =
			
			VAR VariancePct = [Seasonal Benchmark Variance %]
			RETURN
			SWITCH(
			    TRUE(),
			    VariancePct < 0, "#DC2626",    -- Red
			    "#16A34A" --"#6B7280"                          -- Gray
			)
		displayFolder: Q3 — Seasonality\_Formatting & Display
		lineageTag: 21149eb0-436c-4a46-aaa8-856316a283de

	/// Returns dark text (#111827) when the cell's Fostered Animals value is below 1000, otherwise white (#FFFFFF), to keep heatmap cell labels readable against the cell's background color.
	measure 'Seasonal Heatmap Font Color' = ```
			
			VAR Value_ = [Fostered Animals]
			RETURN
			IF(
			    Value_ < 1000,
			    "#111827",
			    "#FFFFFF"
			)/*Seasonal Heatmap Font Color = 
			VAR Value_ = [Fostered Animals]
			RETURN
			IF(
			    Value_ <8000,
			    "#111827",      -- Black Text
			    "#FFFFFF"       -- White Text
			)*/
			```
		displayFolder: Monthly Tracking\_Formatting & Display
		lineageTag: 8e51a49c-3b76-4def-993a-49cb960abc64

	/// Distinct count of animals recorded in the Intake table during the selected reporting period. Represents total shelter intake volume, independent of whether an animal was later fostered.
	measure 'Intake Animal' = DISTINCTCOUNT( 'Intake'[AnimalId] )
		formatString: #,0
		displayFolder: Core Metrics
		lineageTag: 4ac9fa26-9c12-48f4-92c3-772332c3f1aa

	/// Share of intake animals that were also fostered. Formula: Fostered Animals ÷ Intake Animal. The primary utilization metric used throughout the report.
	measure '% Animals In Foster' =
			
			DIVIDE(
			[Fostered Animals],
			[Intake Animal]
			)
		formatString: 0%;-0%;0%
		displayFolder: Core Metrics
		lineageTag: 1cdfd648-cea8-48b4-8330-46f58d9f7d52

	/// Foster utilization rate during the Rapid Growth Phase (2006-2009): total fostered animals divided by total intake animals across the phase. Used as the "Share of intake fostered" stat on the Rapid Growth phase-story card.
	measure 'Rapid Growth Utilization %' =
			
			VAR FosterAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2006 &&
			            'Date'[Year] <= 2009
			        ),
			        CALCULATE([Fostered Animals])
			    )
			
			VAR IntakeAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2006 &&
			            'Date'[Year] <= 2009
			        ),
			        CALCULATE([Intake Animal])
			    )
			
			RETURN
			    DIVIDE(FosterAnimals, IntakeAnimals)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 409c3da7-c77e-4e8f-8432-dc05c833533e

	/// Foster utilization rate during the Program Transition Phase (2010-2013): total fostered animals divided by total intake animals across the phase. Used as the "Share of intake fostered" stat on the Program Transition phase-story card.
	measure 'Program Transition Utilization %' =
			VAR FosterAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2010 &&
			            'Date'[Year] <= 2013
			        ),
			        CALCULATE([Fostered Animals])
			    )
			
			VAR IntakeAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2010 &&
			            'Date'[Year] <= 2013
			        ),
			        CALCULATE([Intake Animal])
			    )
			
			RETURN
			    DIVIDE(FosterAnimals, IntakeAnimals)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 7dab267e-10cb-4179-b490-139314d513b1

	/// Foster utilization rate during the Stable Operations Phase (2014-2019): total fostered animals divided by total intake animals across the phase. Used as the "Share of intake fostered" stat on the Stable Operations phase-story card.
	measure 'Stable Operations Utilization %' =
			VAR FosterAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2014 &&
			            'Date'[Year] <= 2019
			        ),
			        CALCULATE([Fostered Animals])
			    )
			
			VAR IntakeAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= 2014 &&
			            'Date'[Year] <= 2019
			        ),
			        CALCULATE([Intake Animal])
			    )
			
			RETURN
			    DIVIDE(FosterAnimals, IntakeAnimals)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: c7fe0376-57ca-4ac4-8402-be3d3cf499f4

	/// Foster utilization rate during the High Utilization Phase (2020 through the latest completed reporting year): total fostered animals divided by total intake animals across the phase. Used as the "Share of intake fostered" stat on the High Utilization phase-story card.
	measure 'High Utilization Phase Utilization %' =
			VAR PhaseStartYear = 2020
			VAR PhaseEndYear = [Latest Completed Year]
			
			VAR FosterAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= PhaseStartYear &&
			            'Date'[Year] <= PhaseEndYear
			        ),
			        CALCULATE([Fostered Animals])
			    )
			
			VAR IntakeAnimals =
			    SUMX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= PhaseStartYear &&
			            'Date'[Year] <= PhaseEndYear
			        ),
			        CALCULATE([Intake Animal])
			    )
			
			RETURN
			    DIVIDE(FosterAnimals, IntakeAnimals)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 11fd6bdb-e20e-4822-930b-c7fb1f93c7f4

	/// Compound Annual Growth Rate (CAGR) of intake animals during the Rapid Growth Phase (2006-2009). Used as the "Intake CAGR" stat on the Rapid Growth phase-story card.
	measure 'Rapid Growth Intake CAGR' =
			VAR StartYear = 2006
			VAR EndYear = 2009
			
			VAR StartValue =
			    CALCULATE([Intake Animal], REMOVEFILTERS('Date'), 'Date'[Year] = StartYear)
			
			VAR EndValue =
			    CALCULATE([Intake Animal], REMOVEFILTERS('Date'), 'Date'[Year] = EndYear)
			
			VAR NumberOfYears = EndYear - StartYear
			
			RETURN
			IF(
			    StartValue > 0,
			    POWER(DIVIDE(EndValue, StartValue), DIVIDE(1, NumberOfYears)) - 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Q1 — Growth Trend
		lineageTag: 45e30f31-8c85-4d53-9c18-699eed681b05

	/// Compound Annual Growth Rate (CAGR) of intake animals during the Program Transition Phase (2010-2013). Used as the "Intake CAGR" stat on the Program Transition phase-story card.
	measure 'Program Transition Intake CAGR' =
