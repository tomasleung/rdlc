	/// Measures the percentage difference between actual foster participation and the historical ratio forecast for each completed year. Negative values indicate the forecast was higher than actual results, while positive values indicate actual participation exceeded the forecast. Used to evaluate forecast accuracy and reliability.
	/// 
	measure 'Forecast Error Color' =
			
			VAR ErrorPct = [Forecast Error %]
			RETURN
			SWITCH(
			    TRUE(),
			    ErrorPct <= -0.01, "#16A34A",   -- Green
			    ErrorPct >= 0.01, "#DC2626",    -- Red
			    "#16A34A"                       -- Gray
			)
		displayFolder: Forecast Outlook
		lineageTag: bea6eeae-35aa-4f4c-93f2-1870aa10e199

	/// Returns the month with the lowest Monthly Participation value during the current reporting year.
	/// 
	/// Used to identify the lowest participation month in the current operating year.
	measure 'Current Year Lowest Month Fostered Animals' =
			
			VAR ReportingYear =
			    [Latest Reporting Year]
			
			VAR MonthTable =
			    SUMMARIZE(
			        FILTER(
			            ALL('Date'),
			            'Date'[Year] = ReportingYear
			        ),
			        'Date'[Month],
			        "AnimalCount", [Fostered Animals]
			    )
			
			RETURN
			MINX(
			    MonthTable,
			    [AnimalCount]
			)
		formatString: #,0
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 77d7f01f-78d8-4562-a52a-789d4c83e25e

	measure 'Current Year Lowest Month' =
			
			VAR MonthTable =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    )
			
			VAR LowestMonthNumber =
			    MINX(
			        TOPN(
			            1,
			            MonthTable,
			            [MonthlyValue], ASC,
			            'Date'[Month], ASC
			        ),
			        'Date'[Month]
			    )
			
			RETURN
			CALCULATE(
			    MAX('Date'[Month Name]),
			    ALL('Date'),
			    'Date'[Month] = LowestMonthNumber
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 6878319a-31fe-43e8-b502-ef94dad90664

	/// Returns the month with the highest Fostered Animals participation during the latest reporting year.
	/// 
	/// The measure evaluates monthly Fostered Animals counts within the current reporting year and returns the corresponding month name associated with the highest participation level.
	measure 'Current Year Peak Month' =
			
			VAR MonthTable =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    )
			
			VAR PeakMonthNumber =
			    MINX(
			        TOPN(
			            1,
			            MonthTable,
			            [MonthlyValue], DESC,
			            'Date'[Month], ASC
			        ),
			        'Date'[Month]
			    )
			
			RETURN
			CALCULATE(
			    MAX('Date'[Month Name]),
			    ALL('Date'),
			    'Date'[Month] = PeakMonthNumber
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: cf644f21-6e7e-46b0-973d-80476c9a0d78

	/// Returns the highest monthly Fostered Animals participation value observed during the latest reporting year.
	/// 
	/// Used together with Current Year Peak Month to identify the period of highest foster activity within the current operating year.
	measure 'Current Year Peak Month Fostered Animals' =
			
			MAXX(
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('Date'[Month]),
			            "MonthlyValue",
			                [Monthly Participation]
			        ),
			        NOT ISBLANK([MonthlyValue])
			    ),
			    [MonthlyValue]
			)
		formatString: #,0
		displayFolder: Capacity & Support\Seasonality
		lineageTag: be1f8b7b-4134-48e1-92e6-206aaf1c5f63

	/// Measures the percentage difference between the highest and lowest monthly Fostered Animals participation values observed during the latest reporting year.
	/// 
	/// Used to quantify seasonal variation within the current operating year and assess the magnitude of monthly participation fluctuations.
	measure 'Current Year Seasonal Variation %' = ```
			
			DIVIDE(
			    [Current Year Peak Month Fostered Animals]
			        - [Current Year Lowest Month Fostered Animals],
			    [Current Year Lowest Month Fostered Animals]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 42984403-3b49-4a23-829b-aebf9523811e

	/// Seasonal Benchmark Variance Color
	measure 'Seasonal Benchmark Variance Color' =
			
			VAR VariancePct = [Seasonal Benchmark Variance %]
			RETURN
			SWITCH(
			    TRUE(),
			    VariancePct < 0, "#DC2626",    -- Red
			    "#16A34A" --"#6B7280"                          -- Gray
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 21149eb0-436c-4a46-aaa8-856316a283de

	measure 'Seasonal Heatmap Font Color' =
			
			VAR Value_ = [Fostered Animals]
			RETURN
			IF(
			    Value_ <8000,
			    "#111827",      -- Black Text
			    "#FFFFFF"       -- White Text
			)
		lineageTag: 8e51a49c-3b76-4def-993a-49cb960abc64

	partition KPI = m
		mode: import
		source =
				let
				    Source = Table.FromRows(
				        Json.Document(
				            Binary.Decompress(
				                Binary.FromText("i44FAA==", BinaryEncoding.Base64),
				                Compression.Deflate
				            )
				        ),
				        let _t = ((type nullable text) meta [Serialized.Text = true])
				        in type table [Column1 = _t]
				    ),
				    #"Removed Columns" =
				        Table.RemoveColumns(Source, {"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

