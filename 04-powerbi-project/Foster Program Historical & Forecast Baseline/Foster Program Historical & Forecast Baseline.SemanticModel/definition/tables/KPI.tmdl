	/// Executive narrative summarizing seasonal foster participation patterns identified from the 5-Year Seasonal Benchmark curve.
	/// 
	/// Used to provide business interpretation and planning guidance for seasonal operations and resource forecasting.
	measure 'Seasonality Executive Insight' =
			
			"• Foster participation follows a predictable annual cycle." &
			UNICHAR(10) &
			"• Participation builds through spring and peaks in June (9,511 fostered animals)." &
			UNICHAR(10) &
			"• Elevated participation levels are maintained between June and October." &
			UNICHAR(10) &
			"• February is the lowest participation month, averaging 9,046 fostered animals." &
			UNICHAR(10) &
			"• Seasonal variation is modest at 5.14%, supporting proactive capacity and recruitment planning."
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 71c7ce5b-3bc1-4fe0-a32c-77d313578f88

	/// Executive summary headline describing the recent Foster Program participation trend based on completed reporting years and current YTD performance.
	/// 
	/// Used as the primary conclusion for the Recent Stability analysis section.
	measure 'Recent Stability Headline' =
			
			VAR RecentGrowth =
			    [Recent CAGR]
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        ABS(RecentGrowth) <= 0.01,
			            "Recent activity remains stable within a mature operating range.",
			
			        RecentGrowth > 0.01,
			            "Recent volumes continue to trend upward within a mature operating range.",
			
			        RecentGrowth < -0.01,
			            "Recent volumes remain generally stable despite modest recent declines.",
			
			        "Recent participation patterns require further review."
			    )
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: 7501f4e0-c3fb-4098-aa83-4a3e2bddf9a7

	/// Supporting narrative describing the recent operating period used for stability analysis.
	/// 
	/// Provides context for the annual Fostered Animals trend chart, recent average, highest recent year, and Recent CAGR metrics.
	measure 'Recent Stability Description' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			RETURN
			"Annual Fostered Animals (" &
			FORMAT(StartYear, "0") &
			 "-" &
			FORMAT(EndYear, "0") &
			 " plus " &
			 FORMAT([Latest Reporting Year], "0") &
			 " YTD)."
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: 21094ebf-cbf4-48ca-b036-cce23194308f

	/// Filters visuals to the most recent five completed reporting years plus the current reporting year.
	/// 
	/// Used by the Recent Stability chart to display:
	/// 
	/// 2021
	/// 2022
	/// 2023
	/// 2024
	/// 2025
	/// 2026 YTD
	/// 
	/// The measure automatically rolls forward as new reporting years become available.
	measure 'Recent Years Filter' = ```
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Reporting Year]
			
			VAR CurrentYear =
			    SELECTEDVALUE('Date'[Year])
			
			RETURN
			IF(
			    CurrentYear >= StartYear
			        && CurrentYear <= EndYear,
			    1,
			    0
			)
			
			```
		formatString: 0
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: aebf459a-bb91-4b31-a6b8-ea2b72d8e219

	/// Average annual Fostered Animals count across the most recent five completed reporting years.
	/// 
	/// Used to represent the typical annual participation level during the current mature operating period.
	/// 
	/// Example:
	/// 
	/// 2021
	/// 2022
	/// 2023
	/// 2024
	/// 2025
	/// 
	/// Average annual Fostered Animals across those five completed years.
	/// 
	measure 'Recent Average Fostered Animals' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			RETURN
			AVERAGEX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= StartYear
			            && 'Date'[Year] <= EndYear
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: f6547614-161a-4534-ad36-893569aacf3e

	/// Displays the completed-year period used to calculate Recent Average Fostered Animals.
	/// 
	/// Example:
	/// 2021-2025 Mean
	measure 'Recent Average Label' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			RETURN
			FORMAT(StartYear, "0")
			    & "-"
			    & FORMAT(EndYear, "0")
			    & " Mean"
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: 44fb96fd-7818-44fd-b0bf-a14f15fbeb0c

	/// Identifies the completed reporting year with the highest annual Fostered Animals count during the recent operating period.
	/// 
	/// The recent operating period consists of the most recent five completed reporting years.
	/// 
	/// Used by the Highest Recent Year KPI card.
	/// 
	/// Business Meaning
	/// Using:
	/// 2021
	/// 2022
	/// 2023
	/// 2024
	/// 2025
	/// Calculate:
	/// 2021 Fostered Animals
	/// 2022 Fostered Animals
	/// 2023 Fostered Animals
	/// 2024 Fostered Animals
	/// 2025 Fostered Animals
	/// Then identify:
	/// Highest annual value
	/// 
	/// 
	/// 
	measure 'Highest Recent Year' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			VAR HighestValue =
			    MAXX(
			        FILTER(
			            ALL('Date'[Year]),
			            'Date'[Year] >= StartYear
			                && 'Date'[Year] <= EndYear
			        ),
			        CALCULATE(
			            [Fostered Animals]
			        )
			    )
			
			RETURN
			MAXX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= StartYear
			            && 'Date'[Year] <= EndYear
			            && CALCULATE([Fostered Animals]) = HighestValue
			    ),
			    'Date'[Year]
			)
		formatString: 0
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: 8bfa4315-e5ab-4dd2-bb58-e9dc61d904f4

	/// Highest annual Fostered Animals value observed during the most recent five completed reporting years.
	/// 
	/// Used by the Highest Recent Year KPI card.
	measure 'Highest Recent Year Fostered Animals' =
			
			VAR StartYear =
			    [Latest Completed Year] - 4
			
			VAR EndYear =
			    [Latest Completed Year]
			
			RETURN
			MAXX(
			    FILTER(
			        ALL('Date'[Year]),
			        'Date'[Year] >= StartYear
			            && 'Date'[Year] <= EndYear
			    ),
			    CALCULATE(
			        [Fostered Animals]
			    )
			)
		formatString: #,0
		displayFolder: Capacity & Support\Recent Stability
		lineageTag: 8138d14a-e123-46d2-9b37-76e36222b1f6

	/// Displays the year and Fostered Animals value associated with the highest recent participation year.
