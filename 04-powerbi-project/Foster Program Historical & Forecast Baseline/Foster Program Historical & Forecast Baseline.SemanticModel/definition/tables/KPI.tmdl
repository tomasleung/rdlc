	measure 'Prior Year Same Month Fostered Animals' =
			
			VAR LatestMonthKey =
			    MAXX(
			        ALL('Foster Animal Month'),
			        'Foster Animal Month'[Month Date Key]
			    )
			
			VAR LatestDate =
			    LOOKUPVALUE(
			        'Date'[Date],
			        'Date'[Date Key],
			        LatestMonthKey
			    )
			
			VAR PriorYear =
			    YEAR(LatestDate) - 1
			
			VAR CurrentMonth =
			    MONTH(LatestDate)
			
			RETURN
			CALCULATE(
			    [Fostered Animals],
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = PriorYear,
			    'Date'[Month] = CurrentMonth
			)
		formatString: 0
		displayFolder: Capacity & Support\Last Month Comparison
		lineageTag: dec553fb-3d2b-4327-b4aa-b46cb176413b

	measure 'Prior Year Same Month Variance %' =
			
			DIVIDE(
			    [Latest Month Fostered Animals]
			        - [Prior Year Same Month Fostered Animals],
			    [Prior Year Same Month Fostered Animals]
			)
		displayFolder: Capacity & Support\Last Month Comparison
		lineageTag: 5a7b553f-9761-4d6b-b228-2df27e63ed70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prior Year Same Month Comparison Label' =
			
			VAR VariancePct =
			    [Prior Year Same Month Variance %]
			
			VAR LatestDate =
			    [Latest Reporting Date]
			
			RETURN
			IF(
			    VariancePct >= 0,
			    "▲ ",
			    "▼ "
			)
			& FORMAT(ABS(VariancePct), "0.00%")
			& " vs "
			& FORMAT(LatestDate, "MMMM")
			& " "
			& FORMAT(YEAR(LatestDate) - 1, "0")
		displayFolder: Capacity & Support\Last Month Comparison
