	/// Average monthly Fostered Animals participation across the previous five completed years.
	/// 
	/// For each month, the measure calculates the average Fostered Animals value for the same month across the previous five completed reporting years.
	/// 
	/// Example:
	/// 
	/// August Benchmark
	/// 
	/// =
	/// Average(
	/// Aug 2021,
	/// Aug 2022,
	/// Aug 2023,
	/// Aug 2024,
	/// Aug 2025
	/// )
	/// 
	/// Used for seasonality analysis, peak month identification, lowest month identification, and seasonal range calculations.
	measure '5-Year Seasonal Benchmark' =
			
			VAR CurrentMonth =
			    SELECTEDVALUE('Date'[Month])
			
			VAR LatestReportingYear =
			    [Latest Reporting Year]
			
			RETURN
			AVERAGEX(
			    GENERATESERIES(
			        LatestReportingYear - 5,
			        LatestReportingYear - 1
			    ),
			    VAR BenchmarkYear = [Value]
			    RETURN
			        CALCULATE(
			            [Fostered Animals],
			            REMOVEFILTERS('Date'),
			            'Date'[Year] = BenchmarkYear,
			            'Date'[Month] = CurrentMonth
			        )
			)
		formatString: #,0
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 463cfa73-d69a-4673-ac3a-e5c204e491c6

	/// Average monthly Fostered Animals participation based on the 5-Year Seasonal Benchmark curve.
	/// 
	/// Calculated by averaging all twelve monthly benchmark values derived from the previous five completed reporting years.
	/// 
	/// Used as the benchmark reference line for seasonality analysis and to identify peak seasonal activity periods.
	/// Business Meaning
	/// Average of:
	/// 
	/// January Benchmark
	/// February Benchmark
	/// March Benchmark
	/// April Benchmark
	/// May Benchmark
	/// June Benchmark
	/// July Benchmark
	/// August Benchmark
	/// September Benchmark
	/// October Benchmark
	/// November Benchmark
	/// December Benchmark
	/// Example:
	/// (9137 + 9046 + 9113 + ... + 9234)
	/// /
	/// 12
	/// 
	/// 
	measure 'Average Monthly Benchmark' =
			
			AVERAGEX(
			    VALUES('Date'[Month]),
			    [5-Year Seasonal Benchmark]
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: f2f1e9cf-37e9-41c5-a1e3-204de0579a09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Month with the highest Fostered Animals value based on the 5-Year Seasonal Benchmark curve.
	/// 
	/// Used to identify the month with the highest historical seasonal participation across the previous five completed reporting years.
	/// Business Meaning
	/// From the benchmark curve:
	/// Jan = 9,137
	/// Feb = 9,046
	/// Mar = 9,113
	/// Apr = 9,232
	/// May = 9,369
	/// Jun = 9,511  ← Highest
	/// Jul = 9,484
	/// Aug = 9,435
	/// ...
	/// 
	measure 'Peak Month' =
			
			VAR PeakValue =
			    MAXX(
			        VALUES('Date'[Month]),
			        [5-Year Seasonal Benchmark]
			    )
			RETURN
			MAXX(
			    FILTER(
			        VALUES('Date'[Month]),
			        [5-Year Seasonal Benchmark] = PeakValue
			    ),
			    CALCULATE(
			        MAX('Date'[Month Name])
			    )
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 13af5432-e6ab-467f-a174-57f70386d7a7

	/// Highest monthly Fostered Animals value from the 5-Year Seasonal Benchmark curve.
	/// 
	/// Represents the peak seasonal participation level.
	measure 'Peak Month Fostered Animals' =
			
			MAXX(
			    VALUES('Date'[Month]),
			    [5-Year Seasonal Benchmark]
			)
		formatString: #,0
		displayFolder: Capacity & Support\Seasonality
		lineageTag: f75b4e1f-7964-4c45-8895-b45f2dcec8bf

	/// Month with the lowest Fostered Animals value based on the 5-Year Seasonal Benchmark curve.
	/// 
	/// Used to identify the month with the lowest historical seasonal participation across the previous five completed reporting years.
	/// Business Meaning
	/// Jan = 9,137
	/// Feb = 9,046  ← Lowest
	/// Mar = 9,113
	/// Apr = 9,232
	/// May = 9,369
	/// Jun = 9,511
	/// Jul = 9,484
	/// Aug = 9,435
	/// ...
	/// 
	/// 
	/// 
	measure 'Lowest Month' =
			
			VAR LowestValue =
			    MINX(
			        VALUES('Date'[Month]),
			        [5-Year Seasonal Benchmark]
			    )
			RETURN
			MAXX(
			    FILTER(
			        VALUES('Date'[Month]),
			        [5-Year Seasonal Benchmark] = LowestValue
			    ),
			    CALCULATE(
			        MAX('Date'[Month Name])
			    )
			)
		displayFolder: Capacity & Support\Seasonality
		lineageTag: d7c9c4d4-8641-422b-b129-ca90cb6c6d72

	/// Lowest monthly Fostered Animals value from the 5-Year Seasonal Benchmark curve.
	/// 
	/// Represents the lowest seasonal participation level.
	measure 'Lowest Month Fostered Animals' =
			
			MINX(
			    VALUES('Date'[Month]),
			    [5-Year Seasonal Benchmark]
			)
		formatString: #,0
		displayFolder: Capacity & Support\Seasonality
		lineageTag: ba9951d1-5f91-483c-84ec-4ff80fcbf7d7

	/// Percentage difference between the peak seasonal month and the lowest seasonal month based on the 5-Year Seasonal Benchmark curve.
	/// 
	/// Used to quantify the magnitude of seasonal variation in foster participation throughout the year.
	/// 
	/// Formula:
	/// 
	/// (Peak Month Benchmark - Lowest Month Benchmark)
	/// /
	/// Lowest Month Benchmark
	/// Business Meaning
	/// Peak Month = June
	/// Peak Benchmark = 9,511
	/// 
	/// Lowest Month = February
	/// Lowest Benchmark = 9,046
	/// (9,511 - 9,046)
	/// /
	/// 9,046
	/// 
	/// = 5.14%
	/// 
	/// ≈ 5.1%
	/// 
	/// 
	measure 'Seasonal Range %' =
			
			DIVIDE(
			    [Peak Month Fostered Animals]
			        - [Lowest Month Fostered Animals],
			    [Lowest Month Fostered Animals]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 6c181822-178b-4097-b849-2f79b71c6568

	measure 'Seasonal Range Label' =
			
			"Peak ("
			    & LEFT([Peak Month], 3)
			    & ") vs Low ("
			    & LEFT([Lowest Month], 3)
			    & ")"
		displayFolder: Capacity & Support\Seasonality
		lineageTag: 61168505-55dc-4079-9eda-31c7b930c42c

