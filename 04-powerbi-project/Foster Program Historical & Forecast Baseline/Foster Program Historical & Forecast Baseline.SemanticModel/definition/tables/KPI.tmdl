	/// Filters visuals to completed reporting years only.
	/// 
	/// Used to exclude the current in-progress reporting year from historical trend charts, CAGR calculations, and lifecycle analysis visuals.
	/// 
	/// Example:
	/// 
	/// Latest Reporting Year = 2026
	/// 
	/// Included:
	/// 2006-2025
	/// 
	/// Excluded:
	/// 2026
	measure 'Completed Year Filter' =
			
			IF(
			    SELECTEDVALUE('Date'[Year])
			        <= [Latest Completed Year],
			    1,
			    0
			)
		formatString: 0
		displayFolder: Q1 — Growth Trend
		lineageTag: 10428e6b-8a31-4a56-be4d-877360be3142

	/// Executive summary narrative describing the Foster Program lifecycle, historical growth, operating maturity, and current outlook. Intended for executive consumption and strategic context.
	measure 'Executive Summary Narrative' =
			
			"• Foster participation peaked at 7,964 animals in 2009 before stabilizing at lower operating levels in recent years." &
			UNICHAR(10) &
			"• Distinct intake animals declined from approximately 39,755 in 2006 to 13,863 in 2025, representing a significant reduction in animals entering care." &
			UNICHAR(10) &
			"• % Animal In Foster increased from 14.4% in 2006 to 31.1% in 2025, indicating a larger share of animals entering care received foster support." &
			UNICHAR(10) &
			"• Foster participation follows a predictable seasonal cycle, with elevated activity occurring between June and October." &
			UNICHAR(10) &
			"• Recent participation has remained within a relatively narrow operating range despite lower volumes observed since 2024." &
			UNICHAR(10) &
			"• Based on year-to-date activity through August 2026, participation is projected to reach approximately 4,119 fostered animals by year-end, with foster utilization remaining above 30%, " &
			UNICHAR(10) &"  consistent with the current high-utilization environment."
		displayFolder: KPI Scorecards\_Formatting & Display
