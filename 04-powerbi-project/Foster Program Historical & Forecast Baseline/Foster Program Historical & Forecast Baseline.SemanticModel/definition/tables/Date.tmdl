/// Conformed enterprise date dimension used for Foster Analytics reporting.
/// 
/// Supports:
/// • Daily Analysis
/// • Weekly Analysis
/// • Monthly Analysis
/// • Quarterly Analysis
/// • Seasonal Analysis
/// 
/// Source:
/// shared.dim_date
/// 
/// Recommended Usage:
/// • Year-Month for monthly trends
/// • Year-Quarter for quarterly trends
/// • Year-Week for weekly trends
/// 
/// Hidden Fields:
/// • Date Key
/// • Year-Quarter Sort
/// • Year-Week Sort
table Date
	lineageTag: cd82e70a-f152-4213-be93-9781d539a64c

	/// Unique date key in YYYYMMDD format.
	/// Used for relationships between Date and fact tables.
	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f3e063c1-3467-4b8d-9f1c-ef1bf9d385b4
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	/// Calendar date used for reporting.
	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 0fa0c831-6bec-48f5-bd8d-e7651a30f1ed
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Calendar year associated with the reporting date.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: 6d536843-f7ce-4b8d-bc33-c4c9c89b9600
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	/// Calendar quarter associated with the reporting date.
	/// 
	/// Values:
	/// Q1
	/// Q2
	/// Q3
	/// Q4
	column Quarter
		dataType: string
		lineageTag: c8253413-0bf3-434a-a210-1489aa8e1e9b
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	/// Calendar year and quarter combined.
	/// 
	/// Example:
	/// 2026-Q3
	/// 
	/// Recommended for quarterly trend analysis.
	column Year-Quarter
		dataType: string
		lineageTag: 5ca9217e-659b-43e9-b2a1-8dcae0bc8ca4
		summarizeBy: none
		sourceColumn: YearQuarter

		annotation SummarizationSetBy = Automatic

	/// Sort column used by Year-Quarter.
	/// 
	/// Hidden implementation field.
	column 'Year-Quarter Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f70e82f2-1372-4c4e-9476-807723998ec3
		summarizeBy: none
		sourceColumn: YearQuarterSort

		annotation SummarizationSetBy = User

	/// Calendar month number.
	/// 
	/// Values:
	/// 1-12
	/// 
	/// Used primarily for sorting Month Name and Month (Short).
	column Month
		dataType: int64
		formatString: 0
		lineageTag: 044ce2b0-7659-4674-9f6b-9d606b2c65c5
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = User

	/// Full month name.
	/// 
	/// Example:
	/// January
	/// February
	/// March
	/// 
	/// Recommended for month-based reporting and visual labels.
	column 'Month Name'
		dataType: string
		lineageTag: 6f089a4b-2fb1-4cd9-a801-7a658f1efe14
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: Month

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// Abbreviated month name.
	/// 
	/// Example:
	/// Jan
	/// Feb
	/// Mar
	/// 
	/// Recommended for compact charts and trend visuals.
	column 'Month (Short)'
		dataType: string
		lineageTag: 09db2001-9656-47e0-a1a0-24315b7e84c2
		summarizeBy: none
		sourceColumn: MonthShortName
		sortByColumn: Month

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// Calendar year and month combined.
	/// 
	/// Example:
	/// 2026-08
	/// 
	/// Recommended for monthly trend analysis.
	column Year-Month
		dataType: string
		lineageTag: 6a99b21e-af6c-4c11-89d9-1fa9bf1b407a
		summarizeBy: none
		sourceColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	/// Calendar week identifier.
	/// 
	/// Example:
	/// W14
	/// 
	/// Week number within a year.
	column Week
		dataType: string
		lineageTag: 7c72fb37-4584-42dc-b93f-fb8245b1e23d
		summarizeBy: none
		sourceColumn: Week

		annotation SummarizationSetBy = Automatic

	/// Calendar year and week combined.
	/// 
	/// Example:
	/// 2026-W14
	/// 
	/// Recommended for weekly trend analysis.
	column Year-Week
		dataType: string
		lineageTag: 9d95d3bc-a1da-4700-a10d-5ea0ce091781
		summarizeBy: none
		sourceColumn: YearWeek

		annotation SummarizationSetBy = Automatic

	/// Sort column used by Year-Week.
	/// 
	/// Hidden implementation field.
	column 'Year-Week Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: bfd6d206-e5d1-40fc-aaa1-f3b0756da966
		summarizeBy: none
		sourceColumn: YearWeekSort

		annotation SummarizationSetBy = User

	/// Season associated with the reporting date.
	/// 
	/// Values:
	/// Winter
	/// Spring
	/// Summer
	/// Fall
	/// 
	/// Useful for seasonal analysis and trend comparisons.
	column Season
		dataType: string
		lineageTag: 867c28de-58a4-4ff7-a580-94531b1c6b98
		summarizeBy: none
		sourceColumn: Season

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: import
		source =
				let
				    Source = Sql.Database("zwgqkt2gjj5eldaxf5b4c22xm4-xh5tmosahmpudfij3bmp4m6tdy.datawarehouse.fabric.microsoft.com", "wh_enterprise"),
				    shared_dim_date = Source{[Schema="shared",Item="dim_date"]}[Data]
				in
				    shared_dim_date

	annotation PBI_ResultType = Table

