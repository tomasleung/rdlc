          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Year-end forecasts are created using historical participation patterns from completed reporting years. Historical analysis shows that, on average, approximately ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "88.5%",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": " of annual foster participation occurs by the end of August.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This historical completion rate allows current year-to-date participation to be translated into a full-year forecast before year-end data becomes available.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Forecast performance was validated against previously completed years and achieved an average forecasting error of approximately ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "±0.9%.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#000000"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
