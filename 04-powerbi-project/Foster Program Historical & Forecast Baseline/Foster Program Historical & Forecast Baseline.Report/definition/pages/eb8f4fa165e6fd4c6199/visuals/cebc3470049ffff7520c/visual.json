                    "value": "   ",
                    "textStyle": {
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "Animals are counted once per reporting period and may appear in multiple months if foster care spans multiple months.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Light",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• No Simple Summation",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "   Monthly totals cannot be added together because the same animal may be counted in multiple reporting periods.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Light",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Not Intake Reporting",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "Foster Animal Count measures active foster participation, not foster intakes or placement events.",
