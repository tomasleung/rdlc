            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "• Distinct Counting",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
