              {
                "textRuns": [
                  {
                    "value": "The 5-Year Seasonal Benchmark represents the typical level of foster participation expected during each month of the year based on historical performance between ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "2021 ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": "and ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  },
                  {
                    "value": "2025",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#000000"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The benchmark is calculated using the average Foster Animal Count for each calendar month across the five most recent completed reporting years.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Program owners use these benchmark values to compare current-year results against historical expectations, monitor monthly performance, and support seasonal capacity planning.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#475569"
                    }
                  }
                ]
              }
            ]
