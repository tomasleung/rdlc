relationship AnimalIntakes-Date
	fromColumn: 'Animal Intakes'.'Date Key'
	toColumn: Date.'Date Key'

relationship AnimalIntakes-Centre
	fromColumn: 'Animal Intakes'.'Centre ID'
	toColumn: Centre.'Centre ID'

relationship AnimalIntakes-Animal
	fromColumn: 'Animal Intakes'.'Animal Key'
	toColumn: Animal.'Animal Key'

relationship AnimalIntakes-IntakeType
	fromColumn: 'Animal Intakes'.'Intake Type ID'
	toColumn: 'Intake Type'.'Intake Type ID'

