model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date","Centre","Animal","Intake Type","Animal Intakes","DataFolder"]

ref table Date
ref table Centre
ref table Animal
ref table 'Intake Type'
ref table 'Animal Intakes'

ref cultureInfo en-CA

