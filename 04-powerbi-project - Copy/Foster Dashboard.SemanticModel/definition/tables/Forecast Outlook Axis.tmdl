/// Disconnected helper table used to define the custom timeline for the Forecast Outlook visualization.
/// 
/// The table combines historical actual years, the current year projection, and the future planning outlook into a single reporting axis.
/// 
/// Used exclusively by the Forecast Outlook trend chart to display:
/// 
/// • Historical Actuals (2021-2025)
/// • 2026 Projection
/// • 2027 Planning Outlook
/// 
/// The table enables the visualization to display forecast and planning periods that do not exist as actual records in the Date dimension.
table 'Forecast Outlook Axis'
	lineageTag: 86ff2015-4f91-4238-96d4-071f77f16905

	column Period
		lineageTag: 4658b8af-4dfd-4078-b684-f4e214d1e6a4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column SortOrder
		formatString: 0
		lineageTag: 5b94eca1-371c-427c-83fb-a663c085881a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = Automatic

	partition 'Forecast Outlook Axis' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Period", STRING,
				    "SortOrder", INTEGER,
				    {
				        {"2021", 1},
				        {"2022", 2},
				        {"2023", 3},
				        {"2024", 4},
				        {"2025", 5},
				        {"2026 (Proj.)", 6},
				        {"2027 (Outlook)", 7}
				    }
				)

	annotation PBI_Id = 24eb29fd30304a248b30ed5bb5265b6b

