model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

/// Local folder containing the Prototype-mode CSV fixtures generated by rdlc-mock-data-generator.
/// Update this path to match the local checkout location before opening in Power BI Desktop.
expression DataFolder = "C:\RDLC\FosterMockData\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table Date
ref table Centre
ref table Animal
ref table 'Intake Type'
ref table 'Animal Intakes'
